---
import SectionHead from './SectionHead.astro';
import { etapes } from '../data/methode';
---

<section class="sec" id="methode">
  <div class="wrap">
    <SectionHead label="Comment ça se passe">
      <Fragment slot="titre">Vous voyez votre site <span class="acc">avant de payer.</span></Fragment>
      <p>Trois rendez-vous, un seul interlocuteur. Vous payez quand le site est en ligne.</p>
    </SectionHead>
    <div class="etapes rv">
      {etapes.map((e) => (
        <div class="etape">
          <span class="jour">{e.delai}</span>
          <h3>{e.titre}</h3>
          <p>{e.text}</p>
          <span class:list={['paie', { oui: e.payant }]}>{e.paie}</span>
        </div>
      ))}
    </div>
    <p class="etapes-note">*Délai compté une fois vos textes et photos reçus.</p>
  </div>
</section>
