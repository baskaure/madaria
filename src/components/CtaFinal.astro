---
import { contact } from '../data/site';
---

<div class="wrap" style="padding-bottom:110px">
  <div class="glass bigcta rv">
    <h2>Prêt à lancer <span class="grad">votre site internet</span> ?</h2>
    <p>
      Devis chiffré sous 24 heures, où que vous soyez en France. Sans engagement, sans jargon, sans
      mauvaise surprise.
    </p>
    <div class="row">
      <a href="#contact" class="btn btn-p">Démarrer un projet</a>
      <a href={`mailto:${contact.email}`} class="btn btn-g">{contact.email}</a>
    </div>
  </div>
</div>
