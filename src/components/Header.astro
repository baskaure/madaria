---
import Logo from './Logo.astro';
import { nav, contact } from '../data/site';
---

<!-- Lien d'évitement : invisible tant qu'il n'a pas le focus clavier -->
<a class="skip" href="#contenu">Aller au contenu</a>

<header class="sh">
  <nav class="sh-nav" aria-label="Navigation principale">
    <a class="sh-brand" href="/#top"><Logo />MADARIA</a>
    <div class="sh-links">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="sh-actions">
      <a href="/#contact" class="sh-btn">Devis en 24&nbsp;h</a>
      <button class="sh-burger" id="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mmenu">
        <i></i><i></i>
      </button>
    </div>
  </nav>
</header>

<div class="mmenu" id="mmenu">
  <nav class="mmenu-links" aria-label="Navigation mobile">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="mmenu-bas">
    <a href="/#contact" class="sh-btn">Demander un devis</a>
    <div class="mmenu-coord">
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={`tel:${contact.telLien}`}>{contact.tel}</a>
    </div>
  </div>
</div>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mmenu');
  if (burger && menu) {
    const background = Array.from(document.querySelectorAll<HTMLElement>('main, footer, .skip'));
    const setOpen = (open: boolean, restore = true) => {
      menu.classList.toggle('open', open);
      burger.classList.toggle('open', open);
      document.body.classList.toggle('locked', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      background.forEach(el => { el.inert = open; });
      if (!open && restore) burger.focus();
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => {
      if (burger.getAttribute('aria-expanded') !== 'true') return;
      if (e.key === 'Escape') { e.preventDefault(); setOpen(false); }
      if (e.key === 'Tab') {
        const targets = [burger, ...Array.from(menu.querySelectorAll<HTMLElement>('a[href]'))];
        const index = targets.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        targets[(index + (e.shiftKey ? -1 : 1) + targets.length) % targets.length].focus();
      }
    });
    matchMedia('(min-width: 1001px)').addEventListener('change', e => {
      if (e.matches) setOpen(false, false);
    });
  }
  // Une page métier ou ville a son propre formulaire : « Devis » y reste, au lieu
  // de renvoyer vers celui de l'accueil (le métier d'origine serait perdu).
  if (location.pathname !== '/' && document.getElementById('contact')) {
    document.querySelectorAll<HTMLAnchorElement>('a[href="/#contact"]').forEach((a) => { a.href = '#contact'; });
  }
  const header = document.querySelector('header.sh');
  const sentinel = document.getElementById('nav-sentinel');
  if (header && sentinel) new IntersectionObserver(entries => {
    header.classList.toggle('scrolled', !entries[0]?.isIntersecting);
  }).observe(sentinel);
</script>
