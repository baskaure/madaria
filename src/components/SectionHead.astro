---
/**
 * En-tête de section : étiquette et titre à gauche, texte ou lien à droite
 * (slot par défaut, posé tel quel : <p> ou <a class="tlink">).
 */
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="shead rv">
  <div>
    <span class="lab">{label}</span>
    <h2><slot name="titre" /></h2>
  </div>
  <slot />
</div>
