---
import SectionHead from './SectionHead.astro';
import OfferTerms from './OfferTerms.astro';
import PlanCard from './PlanCard.astro';
import { offres, ENGAGEMENT_MOIS } from '../data/offres';
---

<section class="sec" id="offres">
  <div class="wrap">
    <SectionHead label="Offres">
      <Fragment slot="titre">Votre site dès {offres[0].prix}&nbsp;€ par mois, création incluse.</Fragment>
      <p>
        Rien à payer au départ : création, hébergement et mises à jour sont dans l'abonnement.
        Engagement {ENGAGEMENT_MOIS} mois, puis résiliable quand vous voulez.
      </p>
    </SectionHead>
    <div class="plans rv">
      {offres.map((o) => <PlanCard o={o} href={`/?offre=${o.id}#contact`} />)}
    </div>
    <OfferTerms />
  </div>
</section>
