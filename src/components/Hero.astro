---
import Dashboard from './Dashboard.astro';
import { prixEntree } from '../data/offres';
---

<div class="wrap hero">
  <div class="heroglow"></div>

  <div class="badge">
    <i></i><span>Sites, automatisations et outils métier</span>
  </div>

  <h1>
    Votre site internet en ligne en 7 jours.<br />
    <span class="grad">Pas dans trois mois.</span>
  </h1>

  <p class="lead">
    Madaria conçoit vos <b>sites internet</b>, <b>automatisations</b> et <b>outils métier</b>.
    Un interlocuteur direct, du premier échange à la mise en ligne.
  </p>

  <div class="hcta">
    <a href="#contact" class="btn btn-p">Devis en 24 h</a>
    <a href="#realisations" class="btn btn-g">Voir les réalisations</a>
  </div>

  <p class="hero-note">Sites vitrines dès {prixEntree} € HT · Périmètre et calendrier fixés au devis.</p>
  <Dashboard />
</div>
