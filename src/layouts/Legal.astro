---
import Icon from '../components/Icon.astro';
import Base from './Base.astro';
import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Titre affiché en haut de page */
  h1: string;
  majDate: string;
}

const { title, description, h1, majDate } = Astro.props;
---

<Base title={title} description={description}>
  <Background />
  <Header />

  <main id="contenu" class="legal">
    <div class="wrap">
      <a class="retour" href="/"><Icon name="arrowLeft" class="i" /> Retour à l'accueil</a>
      <h1>{h1}</h1>
      <p class="maj">Dernière mise à jour : {majDate}</p>
      <div class="glass corps">
        <slot />
      </div>
    </div>
  </main>

  <Footer />
</Base>
