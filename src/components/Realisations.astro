---
/** Accueil : trois projets phares, le reste sur la page Réalisations. */
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import CarteProjet from './CarteProjet.astro';
import { projet } from '../lib/projets';

const phares = ['kami', 'aurore-piercing', 'recharge-clim'].map(projet);
---

<section class="sec" id="realisations">
  <div class="wrap">
    <SectionHead label="Réalisations">
      <Fragment slot="titre">Des sites déjà livrés.</Fragment>
      <a class="tlink" href="/realisations/">Voir les réalisations<Icon name="arrow" class="i" /></a>
    </SectionHead>
    <div class="projets">
      {phares.map((p) => <CarteProjet p={p} />)}
    </div>
  </div>
</section>
