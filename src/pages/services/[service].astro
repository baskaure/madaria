---
import Base from '../../layouts/Base.astro';
import Ariane from '../../components/Ariane.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import CarteProjet from '../../components/CarteProjet.astro';
import Contact from '../../components/Contact.astro';
import OfferTerms from '../../components/OfferTerms.astro';
import PlanCard from '../../components/PlanCard.astro';
import { prestations } from '../../data/prestations';
import { offres, offresStructurees } from '../../data/offres';
import { projet } from '../../lib/projets';
import { villes } from '../../data/villes';

export function getStaticPaths() {
  return prestations.map((p) => ({ params: { service: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const web = p.slug === 'creation-site-internet';
const exemples = p.projets.map(projet);
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: p.titre, description: p.description, url, provider: { '@id': 'https://madaria.fr/#organisation' }, areaServed: 'France', ...(web ? { offers: offresStructurees } : {}) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://madaria.fr/' },
      { '@type': 'ListItem', position: 2, name: p.titre, item: url },
    ] },
  ],
};
---

<Base title={p.meta} description={p.description}>
  <section class="ph">
    <div class="wrap">
      <Ariane etapes={[{ label: web ? 'Sites internet' : 'Automatisation' }]} />
      <span class="lab">{web ? 'Votre présence en ligne' : 'Vos outils, connectés'}</span>
      <h1>{p.titre}<span class="acc">, avec Madaria.</span></h1>
      <p class="chapo">{p.intro}</p>
      <p class="chapo">{p.audience}</p>
      <div class="hcta">
        <a class="btn btn-p" href="#contact">Demander un devis<Icon name="arrow" class="i" /></a>
        <a class="btn btn-g" href="#exemples">{web ? 'Voir des sites réalisés' : 'Voir un exemple'}</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead label="Votre besoin">
        <Fragment slot="titre">Partir de <span class="acc">votre besoin.</span></Fragment>
      </SectionHead>
      <div class="points rv">
        {p.sections.map((s, i) => (
          <article class="point"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{s.titre}</h3><p>{s.texte}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div class="txt rv">
        <span class="lab">Le périmètre</span>
        <h2>Ce que nous <span class="acc">préparons ensemble.</span></h2>
        <p>Le devis précise les livrables, les accès nécessaires, les validations et le calendrier. Vous savez ce qui est prévu avant le démarrage.</p>
      </div>
      <ul class="coches rv">{p.livrables.map((l) => <li><Icon name="check" class="i" />{l}</li>)}</ul>
    </div>
  </section>

  <section class="sec" id="exemples">
    <div class="wrap">
      <SectionHead label="Réalisations">
        <Fragment slot="titre">{web ? 'Des sites réalisés.' : 'Un exemple d’outil métier.'}</Fragment>
        {web
          ? <a class="tlink" href="/realisations/">Toutes les réalisations<Icon name="arrow" class="i" /></a>
          : <p>KlientMap regroupe recherche, qualification et suivi de prospects. Les flux décrits plus haut sont des exemples à cadrer selon votre organisation.</p>}
      </SectionHead>
      <div class="projets">{exemples.map((r) => <CarteProjet p={r} />)}</div>
    </div>
  </section>

  {web && (
    <section class="sec">
      <div class="wrap">
        <span class="lab">Près de chez vous</span>
        <div class="pastilles">
          {villes.map((x) => <a href={`/creation-site-internet/${x.slug}/`}><span class="ico"><Icon name="pin" /></span>Site internet {x.a}</a>)}
        </div>
      </div>
    </section>
  )}

  <section class="sec" id="tarifs">
    <div class="wrap">
      {web ? (
        <>
          <SectionHead label="Tarifs">
            <Fragment slot="titre">Choisir votre <span class="acc">point de départ.</span></Fragment>
            <p>Création incluse dans l'abonnement, ou prix d'achat en une fois. Le sur-mesure se chiffre sur devis.</p>
          </SectionHead>
          <div class="plans deux rv">{offres.slice(0, 2).map((o) => <PlanCard o={o} href={`?offre=${o.id}#contact`} />)}</div>
          <OfferTerms />
        </>
      ) : (
        <div class="split">
          <div class="rv"><span class="lab">Tarifs</span><h2>Un périmètre, <span class="acc">un devis.</span></h2></div>
          <div class="txt rv"><p>La réalisation est chiffrée sur devis, après cadrage. Les abonnements aux outils, la maintenance et les évolutions éventuelles sont distingués du coût initial.</p></div>
        </div>
      )}
    </div>
  </section>

  <section class="sec">
    <div class="wrap fsplit">
      <div class="intro rv"><span class="lab">Questions</span><h2>Vos questions.</h2><p>Une réponse manque ? Écrivez-nous, vous l'aurez sous 24&nbsp;h.</p></div>
      <div class="faq rv">
        {p.questions.map((q, i) => (
          <details open={i === 0}><summary>{q.q}<Icon name="plus" class="i" /></summary><p>{q.r}</p></details>
        ))}
      </div>
    </div>
  </section>

  <Contact secteur={web ? 'Création ou refonte de site' : 'Automatisation'} />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
