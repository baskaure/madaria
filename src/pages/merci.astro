---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base noindex title="Merci pour votre demande | Madaria" description="Les prochaines étapes de votre demande de devis auprès de Madaria.">
  <Header />
  <main id="contenu" class="legal"><div class="wrap">
    <span class="lab">Votre projet</span>
    <h1>Merci pour <span class="grad">votre demande.</span></h1>
    <div class="glass corps"><p>Nous revenons vers vous sous 24 h pour préciser votre besoin, votre budget et votre calendrier.</p>
    <p>Besoin de compléter votre demande ? Écrivez à <a href="mailto:contact@madaria.fr">contact@madaria.fr</a>.</p>
    <a class="btn btn-p" href="/">Retour à l’accueil</a></div>
  </div></main>
  <Footer />
</Base>
