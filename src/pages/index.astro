---
import Base from "../layouts/Base.astro";
---

<Base>
<div class="atmo"><div class="beam a"></div><div class="beam b"></div><div class="beam c"></div></div>
<div class="stars"></div><div class="grain"></div>

<header>
  <nav class="nav">
    <a class="brand" href="#top">
      <svg viewBox="0 0 255 174" aria-hidden="true"><defs><linearGradient id="gn" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#A78BFA"/><stop offset="1" stop-color="#4F80F0"/></linearGradient></defs><rect x="25" y="0" width="230" height="34" rx="17" fill="#fff"/><rect x="0" y="70" width="190" height="34" rx="17" fill="#fff"/><rect x="20" y="140" width="92" height="34" rx="17" fill="#fff"/><rect x="132" y="140" width="98" height="34" rx="17" fill="url(#gn)"/></svg>
      MADARIA
    </a>
    <div class="links">
      <a href="#services">Services</a><a href="#methode">Méthode</a>
      <a href="#travaux">Travaux</a><a href="#offres">Offres</a><a href="#faq">FAQ</a>
    </div>
    <a href="#contact" class="btn btn-p">Démarrer</a>
    <button class="burger" id="burger" aria-label="Menu"><i></i><i></i></button>
  </nav>
</header>

<div class="mmenu" id="mmenu">
  <a href="#services">Services</a><a href="#methode">Méthode</a><a href="#travaux">Travaux</a>
  <a href="#offres">Offres</a><a href="#faq">FAQ</a><a href="#contact">Démarrer un projet</a>
</div>

<main id="top">

<!-- HERO -->
<div class="wrap hero">
  <div class="badge"><b>Nouveau</b><span>2 créneaux ouverts ce trimestre</span></div>
  <h1>Des sites qui convertissent.<br><span class="grad">Des systèmes qui<br>travaillent seuls.</span></h1>
  <p class="lead">Madaria conçoit votre <b>site internet</b>, automatise vos <b>tâches répétitives</b> et développe les <b>outils métier</b> dont votre activité a besoin. Livré vite. Pensé pour durer.</p>
  <div class="hcta">
    <a href="#contact" class="btn btn-p">Devis en 24 h →</a>
    <a href="#travaux" class="btn btn-g">Voir nos réalisations</a>
  </div>
  <div class="hnote"><em>●</em> 48 projets livrés · 21 jours en moyenne · 98/100 PageSpeed</div>

  <!-- mockup -->
  <div class="mockwrap rv">
    <div class="mock glass">
      <div class="mtop"><i></i><i></i><i></i><span class="url">madaria.fr / tableau-de-bord</span></div>
      <div class="mbody">
        <div class="mside">
          <div class="t">Pilotage</div>
          <a class="on"><s></s> Vue d'ensemble</a>
          <a><s></s> Trafic &amp; SEO</a>
          <a><s></s> Leads</a>
          <a><s></s> Automatisations</a>
          <a><s></s> Facturation</a>
          <div class="t" style="margin-top:14px">Projet</div>
          <a><s></s> Contenus</a>
          <a><s></s> Performance</a>
        </div>
        <div class="mmain">
          <div class="mhead"><b>Bonjour 👋 — voici votre mois</b><span>30 derniers jours</span></div>
          <div class="kpis">
            <div class="kpi"><small>Leads qualifiés</small><b>128</b><u>+42 %</u></div>
            <div class="kpi"><small>Temps admin gagné</small><b>34 h</b><u>+8 h</u></div>
            <div class="kpi"><small>Score PageSpeed</small><b>98</b><u>/100</u></div>
          </div>
          <div class="chart">
            <div class="ct"><span>Demandes entrantes</span><span>automatisées à 100 %</span></div>
            <div class="bars">
              <i data-h="28%"></i><i data-h="42%"></i><i data-h="36%"></i><i data-h="58%"></i>
              <i data-h="49%"></i><i data-h="72%"></i><i class="hi" data-h="96%"></i><i data-h="64%"></i>
              <i data-h="78%"></i><i data-h="55%"></i><i data-h="70%"></i><i data-h="88%"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- LOGOS -->
<div class="wrap strip rv">
  <div class="t">Ils nous font confiance</div>
  <div class="logos">
    <span>Atelier Verel</span><span>Norvia</span><span>Cabinet Halden</span>
    <span>Groupe Astria</span><span>Kimbo Studio</span><span>Lumen&amp;Co</span>
  </div>
</div>

<!-- SERVICES -->
<section id="services">
  <div class="wrap">
    <div class="shead rv">
      <div class="lab">Services</div>
      <h2>Un partenaire unique,<br>de la première ligne au <span class="grad">dernier client</span>.</h2>
      <p>Nous ne vendons pas des pages. Nous construisons des actifs digitaux : rapides, mesurables, et connectés à vos outils métier.</p>
    </div>

    <div class="bento">
      <div class="glass bcard wide rv">
        <div class="spark"></div>
        <div class="ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 13h6"/></svg></div>
        <h3>Sites internet sur-mesure</h3>
        <p>Vitrines, e-commerce, landing pages. Design unique, code propre, chargement instantané et référencement pensé dès la maquette. Aucun template recyclé, aucun constructeur générique.</p>
        <div class="tags"><b>Next.js</b><b>Astro</b><b>Shopify</b><b>Headless CMS</b><b>Webflow</b></div>
      </div>

      <div class="glass bcard wide rv">
        <div class="spark"></div>
        <div class="ico"><svg viewBox="0 0 24 24"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3"/><circle cx="12" cy="12" r="3"/></svg></div>
        <h3>Automatisations</h3>
        <p>Devis, relances, facturation, reporting : vos process tournent sans vous. En moyenne, nos clients récupèrent 6 à 10 heures chaque semaine.</p>
        <div class="tags"><b>n8n</b><b>Make</b><b>IA</b><b>Webhooks</b></div>
      </div>

      <div class="glass bcard rv">
        <div class="spark"></div>
        <div class="ico"><svg viewBox="0 0 24 24"><path d="M8 6l-5 6 5 6M16 6l5 6-5 6"/></svg></div>
        <h3>Développement</h3>
        <p>Applications métier, espaces clients, API et intégrations à votre SI existant.</p>
        <div class="tags"><b>React</b><b>Node</b><b>Postgres</b></div>
      </div>

      <div class="glass bcard rv">
        <div class="spark"></div>
        <div class="ico"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></div>
        <h3>SEO &amp; performance</h3>
        <p>Structure, contenus, Core Web Vitals. On vous rend visible durablement.</p>
        <div class="tags"><b>Audit</b><b>Contenu</b><b>Netlinking</b></div>
      </div>

      <div class="glass bcard rv">
        <div class="spark"></div>
        <div class="ico"><svg viewBox="0 0 24 24"><path d="M12 3l8 4v6c0 4.5-3.2 7.4-8 8.5C7.2 20.4 4 17.5 4 13V7z"/><path d="M9 12l2 2 4-4"/></svg></div>
        <h3>Infogérance</h3>
        <p>Hébergement, sauvegardes, mises à jour, sécurité et supervision continue.</p>
        <div class="tags"><b>Monitoring</b><b>Backups</b><b>SLA</b></div>
      </div>
    </div>
  </div>
</section>

<!-- MÉTHODE -->
<section id="methode">
  <div class="wrap">
    <div class="shead rv">
      <div class="lab">Méthode</div>
      <h2>Quatre étapes.<br><span class="grad">Zéro</span> mauvaise surprise.</h2>
      <p>Un cadre clair, des points hebdomadaires, un accès permanent à l'avancement. Vous savez toujours où en est votre projet.</p>
    </div>

    <div class="tl">
      <div class="tnode on rv"><div class="tdot">01</div>
        <div class="glass tbody"><div class="h"><h3>Cadrage</h3><span class="t">Jour 1 → 3</span></div>
          <p>Un appel de 45 minutes pour comprendre votre marché, vos objectifs et vos contraintes. Vous repartez avec un périmètre chiffré, pas une estimation floue.</p></div></div>
      <div class="tnode on rv"><div class="tdot">02</div>
        <div class="glass tbody"><div class="h"><h3>Design</h3><span class="t">Semaine 1</span></div>
          <p>Maquettes sur-mesure validées avant la moindre ligne de code. Deux tours de retours inclus, sans surcoût.</p></div></div>
      <div class="tnode on rv"><div class="tdot">03</div>
        <div class="glass tbody"><div class="h"><h3>Build</h3><span class="t">Semaine 2 → 3</span></div>
          <p>Développement, intégration des contenus, automatisations, tests sur tous les écrans et navigateurs. Préproduction accessible en continu.</p></div></div>
      <div class="tnode rv"><div class="tdot">04</div>
        <div class="glass tbody"><div class="h"><h3>Lancement</h3><span class="t">J+21 → suivi 12 mois</span></div>
          <p>Mise en ligne, formation enregistrée, suivi des performances et optimisations continues.</p></div></div>
    </div>
  </div>
</section>

<!-- TRAVAUX -->
<section id="travaux">
  <div class="wrap">
    <div class="shead rv">
      <div class="lab">Travaux</div>
      <h2>Des projets qui <span class="grad">rapportent</span>.</h2>
      <p>Chaque projet est mesuré : trafic, conversions, temps gagné. Pas de captures flatteuses sans chiffres derrière.</p>
    </div>
    <div class="works">
      <div class="glass work rv"><div class="wtop w1"></div>
        <div class="wbody"><div class="meta">E-commerce · Artisanat</div><h3>Atelier Verel</h3>
          <p>Refonte complète de la boutique et automatisation du suivi de commandes.</p>
          <div class="wkpi"><div><b>+164 %</b><span>commandes</span></div><div><b>−70 %</b><span>temps admin</span></div></div></div></div>
      <div class="glass work rv"><div class="wtop w2"></div>
        <div class="wbody"><div class="meta">SaaS · B2B</div><h3>Norvia</h3>
          <p>Site vitrine, espace client et connexion CRM livrés en trois semaines.</p>
          <div class="wkpi"><div><b>3 sem.</b><span>maquette → live</span></div><div><b>×2,4</b><span>leads</span></div></div></div></div>
      <div class="glass work rv"><div class="wtop w3"></div>
        <div class="wbody"><div class="meta">Services · Local</div><h3>Cabinet Halden</h3>
          <p>Prise de rendez-vous en ligne, relances automatiques et SEO local.</p>
          <div class="wkpi"><div><b>#1</b><span>sur 8 requêtes</span></div><div><b>+38 %</b><span>rendez-vous</span></div></div></div></div>
    </div>
  </div>
</section>

<!-- OFFRES -->
<section id="offres">
  <div class="wrap">
    <div class="shead rv">
      <div class="lab">Offres</div>
      <h2>Un tarif clair,<br>annoncé <span class="grad">avant</span> de commencer.</h2>
      <p>Paiement en trois fois sans frais. Aucun coût caché : ce qui est dans le devis est dans la livraison.</p>
    </div>
    <div class="plans">
      <div class="glass plan rv">
        <div class="pn"><span>Essentiel</span></div>
        <div class="price">1 490 <sup>€ HT</sup></div>
        <p class="d">Le site vitrine qui installe votre crédibilité et capte vos premiers leads.</p>
        <ul><li>Jusqu'à 5 pages sur-mesure</li><li>Design original, responsive</li>
          <li>SEO de base + Analytics</li><li>Formulaire de contact</li><li>Livraison en 3 semaines</li></ul>
        <a href="#contact" class="btn btn-g">Choisir Essentiel</a>
      </div>
      <div class="glass plan feat rv">
        <div class="pn"><span>Signature</span><em>Le plus choisi</em></div>
        <div class="price">3 900 <sup>€ HT</sup></div>
        <p class="d">Le site complet, connecté à vos outils, avec vos process déjà automatisés.</p>
        <ul><li>Pages illimitées + blog</li><li>Direction artistique dédiée</li>
          <li>2 automatisations métier</li><li>CRM / réservation / paiement</li>
          <li>SEO avancé + rédaction</li><li>3 mois de suivi inclus</li></ul>
        <a href="#contact" class="btn btn-p">Choisir Signature</a>
      </div>
      <div class="glass plan rv">
        <div class="pn"><span>Sur-mesure</span></div>
        <div class="price">Sur devis</div>
        <p class="d">Application métier, plateforme, système d'automatisation à l'échelle.</p>
        <ul><li>Cadrage et architecture</li><li>Développement full-stack</li>
          <li>Intégrations API illimitées</li><li>Automatisations IA</li><li>Contrat de maintenance</li></ul>
        <a href="#contact" class="btn btn-g">Parler du projet</a>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq">
  <div class="wrap">
    <div class="shead rv">
      <div class="lab">FAQ</div>
      <h2>Tout ce que vous vous demandez <span class="grad">avant</span> de nous écrire.</h2>
    </div>
    <div class="faq rv">
      <details open><summary>Combien de temps pour un site ?<span class="pm">+</span></summary>
        <p>Trois semaines en moyenne pour un site vitrine, six à huit semaines pour un e-commerce ou une application. Le planning est fixé au cadrage et nous le tenons.</p></details>
      <details><summary>Je peux modifier mon site moi-même ?<span class="pm">+</span></summary>
        <p>Oui. Chaque site est livré avec une interface d'administration simple et une session de formation enregistrée. Vous restez autonome sur vos contenus.</p></details>
      <details><summary>Concrètement, qu'est-ce qu'une automatisation ?<span class="pm">+</span></summary>
        <p>Un formulaire rempli qui crée la fiche client, envoie le devis, programme la relance et met à jour votre tableau de bord — sans intervention humaine. En moyenne, nos clients récupèrent 6 à 10 heures par semaine.</p></details>
      <details><summary>À qui appartient le site une fois livré ?<span class="pm">+</span></summary>
        <p>À vous, intégralement : code, noms de domaine, comptes d'hébergement, contenus. Aucun verrouillage, aucune dépendance imposée.</p></details>
      <details><summary>Et après la mise en ligne ?<span class="pm">+</span></summary>
        <p>Vous choisissez : autonomie complète, ou contrat de maintenance mensuel (mises à jour, sauvegardes, sécurité, évolutions et rapport de performance).</p></details>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="wrap cgrid">
    <div class="glass cinfo rv">
      <h2>Parlons de votre projet.<br><span class="grad">Le café est offert.</span></h2>
      <p>Un échange de 30 minutes, sans engagement, pour évaluer ce qui est faisable, à quel prix et en combien de temps.</p>
      <div class="crow"><span>Mail</span><span>contact@madaria.fr</span></div>
      <div class="crow"><span>Téléphone</span><span>+33 6 00 00 00 00</span></div>
      <div class="crow"><span>Zone</span><span>France · 100 % à distance</span></div>
      <div class="crow"><span>Délai</span><span style="color:#6EE7A8">Réponse sous 24 h ouvrées</span></div>
    </div>

    <form class="glass rv" id="form" novalidate>
      <div class="f"><label for="n-nom">Nom</label><input id="n-nom" name="nom" type="text" placeholder="Jean Dupont" required></div>
      <div class="f"><label for="n-mail">Email</label><input id="n-mail" name="email" type="email" placeholder="jean@entreprise.fr" required></div>
      <div class="f"><label for="n-soc">Société</label><input id="n-soc" name="societe" type="text" placeholder="Entreprise SARL"></div>
      <div class="f"><label for="n-bud">Budget</label>
        <select id="n-bud" name="budget"><option>1 500 – 3 000 €</option><option>3 000 – 6 000 €</option>
          <option>6 000 – 15 000 €</option><option>15 000 € et plus</option><option>Je ne sais pas encore</option></select></div>
      <div class="f full"><label for="n-msg">Votre projet</label>
        <textarea id="n-msg" name="message" placeholder="Décrivez en quelques lignes ce que vous voulez construire…" required></textarea></div>
      <div class="f full"><button type="submit" class="btn btn-p">Envoyer la demande →</button>
        <div class="fmsg" id="fmsg"></div></div>
    </form>
  </div>
</section>

<div class="wrap" style="padding-bottom:110px">
  <div class="glass bigcta rv">
    <h2>Prêt à passer <span class="grad">en production</span> ?</h2>
    <p>Devis chiffré sous 24 heures. Sans engagement, sans jargon, sans mauvaise surprise.</p>
    <div class="row">
      <a href="#contact" class="btn btn-p">Démarrer un projet →</a>
      <a href="mailto:contact@madaria.fr" class="btn btn-g">contact@madaria.fr</a>
    </div>
  </div>
</div>

</main>

<footer>
  <div class="wrap">
    <div class="fg">
      <div>
        <a class="brand" href="#top">
          <svg viewBox="0 0 255 174" aria-hidden="true"><rect x="25" y="0" width="230" height="34" rx="17" fill="#fff"/><rect x="0" y="70" width="190" height="34" rx="17" fill="#fff"/><rect x="20" y="140" width="92" height="34" rx="17" fill="#fff"/><rect x="132" y="140" width="98" height="34" rx="17" fill="url(#gn)"/></svg>
          MADARIA
        </a>
        <p>Agence digitale française. Sites internet, automatisations et développement sur-mesure.</p>
      </div>
      <div><h4>Services</h4><ul><li><a href="#services">Sites internet</a></li><li><a href="#services">Automatisations</a></li><li><a href="#services">Développement</a></li><li><a href="#services">SEO</a></li></ul></div>
      <div><h4>Agence</h4><ul><li><a href="#methode">Méthode</a></li><li><a href="#travaux">Travaux</a></li><li><a href="#offres">Offres</a></li><li><a href="#faq">FAQ</a></li></ul></div>
      <div><h4>Contact</h4><ul><li><a href="mailto:contact@madaria.fr">contact@madaria.fr</a></li><li><a href="#contact">Demander un devis</a></li><li><a href="#contact">Réserver un appel</a></li></ul></div>
    </div>
    <div class="fbot"><span>© 2026 Madaria — tous droits réservés</span><span>Mentions légales · Confidentialité</span></div>
  </div>
</footer>
</Base>

<script>
(function(){
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(!e.isIntersecting) return;
      e.target.classList.add('in'); io.unobserve(e.target);
      if(e.target.classList.contains('mockwrap')) bars();
    });
  }, {threshold:.12, rootMargin:'0px 0px -50px 0px'});
  document.querySelectorAll('.rv').forEach(function(el,i){
    el.style.transitionDelay = (Math.min(i,5)*65)+'ms'; io.observe(el);
  });

  var done = false;
  function bars(){
    if(done) return; done = true;
    document.querySelectorAll('.bars i').forEach(function(b,i){
      setTimeout(function(){ b.style.height = b.dataset.h; }, 260 + i*70);
    });
  }

  // lueur qui suit le curseur sur les cartes bento
  document.querySelectorAll('.bcard').forEach(function(c){
    c.addEventListener('pointermove', function(e){
      var r = c.getBoundingClientRect();
      var s = c.querySelector('.spark');
      s.style.left = (e.clientX - r.left - 120) + 'px';
      s.style.right = 'auto'; s.style.width = '240px';
    });
  });

  var burger = document.getElementById('burger'), mmenu = document.getElementById('mmenu');
  burger.addEventListener('click', function(){
    mmenu.classList.toggle('open');
    document.body.classList.toggle('locked', mmenu.classList.contains('open'));
  });
  mmenu.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ mmenu.classList.remove('open'); document.body.classList.remove('locked'); });
  });

  var form = document.getElementById('form'), msg = document.getElementById('fmsg');
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var nom = form.nom.value.trim(), mail = form.email.value.trim(), txt = form.message.value.trim();
    if(!nom || !mail || !txt){ msg.style.color='#FCA5A5'; msg.textContent='Nom, email et description sont requis.'; return; }
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail)){ msg.style.color='#FCA5A5'; msg.textContent='Adresse email invalide.'; return; }
    msg.style.color='#6EE7A8';
    msg.textContent='Demande enregistrée — réponse sous 24 h ouvrées. (démo : à brancher sur un backend)';
    form.reset();
  });
})();
</script>
