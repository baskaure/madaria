---
import Base from '../../layouts/Base.astro';
import Ariane from '../../components/Ariane.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import CarteProjet from '../../components/CarteProjet.astro';
import Contact from '../../components/Contact.astro';
import OfferTerms from '../../components/OfferTerms.astro';
import PlanCard from '../../components/PlanCard.astro';
import { secteurs } from '../../data/secteurs';
import { offres, offresLd } from '../../data/offres';
import { projet } from '../../lib/projets';

export function getStaticPaths() {
  return secteurs.map((s) => ({ params: { secteur: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;

// Deux offres suffisent sur une page métier : l'entrée de gamme et la complète.
const offresPage = offres.slice(0, 2);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: s.h1,
      serviceType: 'Création de site internet',
      provider: { '@id': 'https://madaria.fr/#organisation' },
      areaServed: [
        { '@type': 'City', name: 'Lyon' },
        { '@type': 'Country', name: 'France' },
      ],
      description: s.metaDesc,
      offers: offresLd(offresPage),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://madaria.fr/' },
        { '@type': 'ListItem', position: 2, name: s.nom, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: s.faq.map((q) => ({
        '@type': 'Question',
        name: q.q,
        acceptedAnswer: { '@type': 'Answer', text: q.r },
      })),
    },
  ],
};

const projetsMetier: Record<string, string[]> = { restaurant: ['kami', 'munda-kfe'], perceur: ['aurore-piercing'], 'btp-artisan': ['recharge-clim'] };
const exemples = (projetsMetier[s.slug] ?? []).map(projet);
const autres = secteurs.filter((x) => x.slug !== s.slug);
---

<Base title={s.metaTitle} description={s.metaDesc}>
  <section class="ph">
    <div class="wrap">
      <Ariane etapes={[{ label: s.nom }]} />
      <div class="ico" aria-hidden="true"><Icon name={s.icon} /></div>
      <h1>{s.h1} <span class="acc">à Lyon et partout en France.</span></h1>
      {s.intro.map((p) => <p class="chapo">{p}</p>)}
      <div class="hcta">
        <a href="#contact" class="btn btn-p">Devis en 24&nbsp;h<Icon name="arrow" class="i" /></a>
        <a href="#tarifs" class="btn btn-g">Voir les tarifs</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead label="Les enjeux">
        <Fragment slot="titre">Ce dont un {s.singulier} a <span class="acc">vraiment besoin.</span></Fragment>
      </SectionHead>
      <div class="points deux rv">
        {s.enjeux.map((e, i) => (
          <article class="point"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{e.titre}</h3><p>{e.text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div class="txt rv">
        <span class="lab">Le périmètre</span>
        <h2>Ce que nous <span class="acc">livrons.</span></h2>
        <p>
          Chaque site est construit sur mesure, sans thème acheté ni constructeur générique. Pour une vitrine,
          le planning de sept jours démarre après cadrage et réception des éléments nécessaires. La maquette est
          incluse : vous validez le design avant la moindre ligne de code.
        </p>
        <div class="hcta"><a href="#contact" class="btn btn-p">Demander un devis</a></div>
      </div>
      <ul class="coches rv">{s.livrables.map((l) => <li><Icon name="check" class="i" />{l}</li>)}</ul>
    </div>
  </section>

  {exemples.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <SectionHead label="Réalisations">
          <Fragment slot="titre">Des projets <span class="acc">dans votre univers.</span></Fragment>
          <a class="tlink" href="/realisations/">Toutes les réalisations<Icon name="arrow" class="i" /></a>
        </SectionHead>
        <div class="projets">{exemples.map((p) => <CarteProjet p={p} />)}</div>
      </div>
    </section>
  )}

  <section class="sec" id="tarifs">
    <div class="wrap">
      <SectionHead label="Tarifs">
        <Fragment slot="titre">Combien coûte un site internet pour {s.singulier}&nbsp;?</Fragment>
        <p>Création incluse dans l'abonnement, ou prix d'achat en une fois. Rien à payer au départ.</p>
      </SectionHead>
      <div class="plans deux rv">{offresPage.map((o) => <PlanCard o={o} href={`?offre=${o.id}#contact`} />)}</div>
      <OfferTerms />
    </div>
  </section>

  <section class="sec">
    <div class="wrap fsplit">
      <div class="intro rv"><span class="lab">Questions</span><h2>Questions fréquentes.</h2><p>Une réponse manque ? Écrivez-nous, vous l'aurez sous 24&nbsp;h.</p></div>
      <div class="faq rv">
        {s.faq.map((q, i) => (
          <details open={i === 0}><summary>{q.q}<Icon name="plus" class="i" /></summary><p>{q.r}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <span class="lab">Autres métiers accompagnés</span>
      <div class="pastilles">
        {autres.map((a) => <a href={`/site-internet/${a.slug}/`}><span class="ico"><Icon name={a.icon} /></span>{a.nom}</a>)}
      </div>
    </div>
  </section>

  <Contact secteur={s.nom} />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
