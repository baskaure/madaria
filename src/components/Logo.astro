---
interface Props {
  /** identifiant unique du dégradé, requis si plusieurs logos coexistent sur la page */
  gradientId?: string;
}

const { gradientId = 'gn' } = Astro.props;
---

<svg viewBox="0 0 255 174" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#A78BFA" />
      <stop offset="1" stop-color="#4F80F0" />
    </linearGradient>
  </defs>
  <rect x="25" y="0" width="230" height="34" rx="17" fill="#fff" />
  <rect x="0" y="70" width="190" height="34" rx="17" fill="#fff" />
  <rect x="20" y="140" width="92" height="34" rx="17" fill="#fff" />
  <rect x="132" y="140" width="98" height="34" rx="17" fill={`url(#${gradientId})`} />
</svg>
