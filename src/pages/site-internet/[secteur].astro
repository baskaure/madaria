---
import Base from '../../layouts/Base.astro';
import Background from '../../components/Background.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { secteurs } from '../../data/secteurs';
import { offres } from '../../data/offres';
import { contact } from '../../data/site';

export function getStaticPaths() {
  return secteurs.map((s) => ({ params: { secteur: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;

// Deux offres suffisent sur une page métier : l'entrée de gamme et la complète.
const offresPage = offres.slice(0, 2);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: s.h1,
      serviceType: 'Création de site internet',
      provider: { '@id': 'https://madaria.fr/#organisation' },
      areaServed: [
        { '@type': 'City', name: 'Lyon' },
        { '@type': 'Country', name: 'France' },
      ],
      description: s.metaDesc,
      offers: offresPage.map((o) => ({
        '@type': 'Offer',
        name: o.nom,
        price: o.prix.replace(/\s/g, ''),
        priceCurrency: 'EUR',
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://madaria.fr/' },
        { '@type': 'ListItem', position: 2, name: s.nom, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: s.faq.map((q) => ({
        '@type': 'Question',
        name: q.q,
        acceptedAnswer: { '@type': 'Answer', text: q.r },
      })),
    },
  ],
};

const autres = secteurs.filter((x) => x.slug !== s.slug);
---

<Base title={s.metaTitle} description={s.metaDesc}>
  <Background />
  <Header />

  <main id="contenu" class="metier">
    <div class="wrap">
      <nav class="ariane" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a> <span>/</span> <span>{s.nom}</span>
      </nav>

      <div class="metier-hero">
        <div class="ico-grand"><Icon name={s.icon} /></div>
        <h1>{s.h1} <span class="grad">à Lyon et partout en France</span></h1>
        {s.intro.map((p) => <p class="chapo">{p}</p>)}
        <div class="hcta">
          <a href="#devis" class="btn btn-p">Devis en 24 h</a>
          <a href="/#offres" class="btn btn-g">Voir les tarifs</a>
        </div>
      </div>

      <section class="bloc">
        <h2>Ce dont un {s.singulier} a <span class="grad">vraiment besoin</span></h2>
        <div class="enjeux">
          {s.enjeux.map((e, i) => (
            <div class="glass enjeu rv">
              <div class="num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{e.titre}</h3>
              <p>{e.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="bloc">
        <div class="split">
          <div>
            <h2>Ce que nous <span class="grad">livrons</span></h2>
            <p class="chapo">
              Chaque site est construit sur mesure, sans thème acheté ni constructeur générique, et
              livré en sept jours. La maquette est offerte et comprise dans le prix : vous validez
              le design avant la moindre ligne de code.
            </p>
            <div class="hcta">
              <a href="#devis" class="btn btn-p">Demander un devis</a>
            </div>
          </div>
          <ul class="glass livrables rv">
            {s.livrables.map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </section>

      <section class="bloc">
        <h2>Combien coûte un site internet pour{' '}
          <span class="grad">{s.singulier}</span> ?</h2>
        <div class="plans deux">
          {offresPage.map((o) => (
            <div class:list={['glass', 'plan', 'rv', { feat: o.feat }]}>
              <div class="pn">
                <span>{o.nom}</span>
                {o.badge && <em>{o.badge}</em>}
              </div>
              <div class="price">{o.prix}{o.unite && <sup>{o.unite}</sup>}</div>
              <p class="d">{o.accroche}</p>
              <ul>{o.inclus.map((i) => <li>{i}</li>)}</ul>
              <a href="#devis" class:list={['btn', o.feat ? 'btn-p' : 'btn-g']}>{o.cta}</a>
            </div>
          ))}
        </div>
      </section>

      <section class="bloc">
        <h2>Questions fréquentes</h2>
        <div class="faq rv">
          {s.faq.map((q, i) => (
            <details open={i === 0}>
              <summary>{q.q}<span class="pm">+</span></summary>
              <p>{q.r}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="bloc" id="devis">
        <div class="glass bigcta rv">
          <h2>Parlons de votre projet</h2>
          <p>
            Devis chiffré sous 24 heures, sans engagement. Décrivez-nous votre activité, nous vous
            disons ce qui est faisable, à quel prix et en combien de temps.
          </p>
          <div class="row">
            <a href={`mailto:${contact.email}`} class="btn btn-p">{contact.email}</a>
            <a href={`tel:${contact.telLien}`} class="btn btn-g">{contact.tel}</a>
          </div>
        </div>
      </section>

      <section class="bloc">
        <h2>Autres métiers accompagnés</h2>
        <div class="liens-metiers">
          {autres.map((a) => (
            <a href={`/site-internet/${a.slug}/`}>
              <Icon name={a.icon} />{a.nom}
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
