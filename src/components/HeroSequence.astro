    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .sq-shot {
    clip-path: inset(0 0 100% 0);
  }
  /* front de lumière : un voile qui descend avec la découpe, fin liseré au bord */
  .sq-scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 2;
    height: 22cqh;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--lav) 10%, transparent) 70%,
      color-mix(in srgb, var(--glow) 32%, transparent));
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }
  .sq-scan::after {
    content: '';
    position: absolute;
    left: 0;
