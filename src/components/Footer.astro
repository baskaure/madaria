---
import Logo from './Logo.astro';
import ParticleWordmark from './ParticleWordmark.astro';
import { footerColumns } from '../data/site';

const annee = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="fg">
      <div>
        <a class="brand" href="/#top">
          <Logo gradientId="gn-footer" />
          MADARIA
        </a>
        <p>
          Agence digitale basée à Lyon. Création de sites internet, automatisations et
          développement sur-mesure, partout en France.
        </p>
      </div>

      {footerColumns.map((col) => (
        <div>
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>

    <ParticleWordmark text="MADARIA" />

    <div class="fbot">
      <span>© {annee} Madaria — tous droits réservés</span>
      <span>
        <a href="/mentions-legales/">Mentions légales</a>{' · '}
        <a href="/confidentialite/">Confidentialité</a>
      </span>
    </div>
  </div>
</footer>
