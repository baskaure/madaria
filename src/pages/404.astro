---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { secteurs } from '../data/secteurs';

// Netlify sert dist/404.html pour toute URL inconnue, avec un vrai statut 404.
---

<Base noindex title="Page introuvable | Madaria" description="Cette page n'existe pas ou a été déplacée.">
  <section class="ph">
    <div class="wrap">
      <span class="lab">Erreur 404</span>
      <h1>Cette page <span class="acc">n'existe pas.</span></h1>
      <p class="chapo">L'adresse ne mène nulle part : la page a été déplacée, ou le lien comportait une erreur.</p>
      <div class="hcta"><a class="btn btn-p" href="/">Retour à l'accueil<Icon name="arrow" class="i" /></a><a class="btn btn-g" href="/#contact">Demander un devis</a></div>
    </div>
  </section>
  <section class="sec court">
    <div class="wrap">
      <span class="lab">Un site pour votre métier</span>
      <div class="pastilles">
        {secteurs.map((s) => <a href={`/site-internet/${s.slug}/`}><span class="ico"><Icon name={s.icon} /></span>{s.nom}</a>)}
      </div>
    </div>
  </section>
</Base>
