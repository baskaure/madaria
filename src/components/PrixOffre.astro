---
/**
 * Prix d'une formule : la mensualité en grand, puis l'engagement et le prix
 * d'achat en une fois (ou la note d'une formule sur devis).
 */
import { ENGAGEMENT_MOIS, type Offre } from '../data/offres';

interface Props {
  o: Offre;
}
const { o } = Astro.props;
// « € HT/mois » devient « € HT / mois »
const unite = o.unite?.replace('/', ' / ');
---

{o.unite ? <div class="prix">{o.prix}<small>{unite}</small></div> : <div class="prix devis">{o.prix}</div>}
<p class="achat">
  {o.achat ? <>Engagement {ENGAGEMENT_MOIS} mois · ou <b>{o.achat}&nbsp;€&nbsp;HT</b> en une fois</> : o.note}
</p>
