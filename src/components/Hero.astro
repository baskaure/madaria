---
import Dashboard from './Dashboard.astro';
---

<div class="wrap hero">
  <div class="heroglow"></div>

  <div class="badge">
    <i></i><span>Sites, automatisations et outils métier</span>
  </div>

  <h1>
    Votre site en ligne en une semaine.<br />
    <span class="grad">Pas dans trois mois.</span>
  </h1>

  <p class="lead">
    Madaria conçoit votre <b>site internet</b>, automatise vos <b>tâches répétitives</b> et
    développe vos <b>outils métier</b>. Qualité d'agence, délais et tarifs qui n'ont rien à voir.
  </p>

  <div class="hcta">
    <a href="#contact" class="btn btn-p">Devis en 24 h</a>
    <a href="#travaux" class="btn btn-g">Voir nos réalisations</a>
  </div>

  <Dashboard />
</div>
