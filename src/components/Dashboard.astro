---
/**
 * Vitrine du hero : un site réellement livré, présenté dans un cadre de verre.
 *
 * Remplace l'ancienne maquette de tableau de bord, dont les chiffres étaient
 * inventés : montrer une réalisation répond à la seule question que se pose un
 * visiteur d'agence — « est-ce qu'ils font de beaux sites ? ».
 */
import { vitrine as vedette } from '../data/realisations';
---

<div class="mockwrap rv">
  <!-- faisceau néon unique projeté au-dessus de l'écran -->
  <div class="proj" aria-hidden="true"><i></i></div>

  <div class="mockframe">
    <div class="mock glass">
      <div class="mtop">
        <i></i><i></i><i></i>
        <span class="url">{vedette.nom} — {vedette.secteur}</span>
      </div>

      <div class="mshot">
        {/* La page du site qui défile, en boucle et sans son. Le poster
            s'affiche en attendant la vidéo, et reste seul si l'utilisateur
            préfère moins d'animations (voir le script plus bas). */}
        <video
          id="vitrine-video"
          autoplay
          muted
          loop
          playsinline
          disablepictureinpicture
          disableremoteplayback
          preload="auto"
          poster={vedette.poster}
          width={vedette.largeur}
          height={vedette.hauteur}
          aria-label={`Site internet réalisé pour ${vedette.nom} : la page défile`}
        >
          <source src={vedette.video.webm} type="video/webm" />
          <source src={vedette.video.mp4} type="video/mp4" />
          <img
            src={vedette.poster}
            alt={`Site internet réalisé pour ${vedette.nom}`}
            width={vedette.largeur}
            height={vedette.hauteur}
            loading="eager"
            decoding="async"
          />
        </video>
      </div>
    </div>
  </div>
</div>

<script>
  // Moins d'animations demandé : on laisse le poster, la vidéo ne démarre pas.
  const v = document.getElementById('vitrine-video') as HTMLVideoElement | null;
  if (v && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.removeAttribute('autoplay');
    v.pause();
    v.currentTime = 0;
  }
</script>
