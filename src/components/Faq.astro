---
import { questions } from '../data/faq';
---

<section id="faq">
  <div class="wrap fsplit">
    <div class="fintro rv">
      <div class="lab">FAQ</div>
      <h2>
        Tout ce que vous vous demandez <span class="grad">avant</span> de nous écrire.
      </h2>
      <p>Une réponse manque ? Écrivez-nous, vous l'aurez sous 24 h.</p>
      <a href="#contact" class="btn btn-g">Poser une question</a>
    </div>

    <div class="faq rv">
      {questions.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}<span class="pm">+</span></summary>
          <p>{item.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
