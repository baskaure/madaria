---
import SectionHead from './SectionHead.astro';
import { etapes } from '../data/methode';
---

<section class="sec" id="methode">
  <div class="wrap">
    <SectionHead label="Comment ça se passe">
      <Fragment slot="titre">Vous validez votre site <span class="acc">avant qu'il soit construit.</span></Fragment>
      <p>Trois rendez-vous, un seul interlocuteur. En abonnement, rien à payer au départ.</p>
    </SectionHead>
    <div class="etapes rv">
      {etapes.map((e) => (
        <div class="etape">
          <span class="jour">{e.delai}</span>
          <h3>{e.titre}</h3>
          <p>{e.text}</p>
          <span class:list={['paie', { oui: e.payant }]}>{e.paie}</span>
        </div>
      ))}
    </div>
    <p class="etapes-note">*Site vitrine : délai compté après accord sur le devis et réception de vos textes et photos.</p>
  </div>
</section>
