---
/**
 * Barre d'appel fixe en bas de l'écran, téléphone uniquement (voir .barre
 * dans global.css). Elle reste cachée tant que les boutons du haut de page
 * (marqués `data-seuil`) sont visibles : inutile de doubler un appel à
 * l'action déjà sous les yeux.
 */
import Icon from './Icon.astro';
import { contact } from '../data/site';

interface Props {
  /** cible du bouton principal */
  href: string;
}
const { href } = Astro.props;
---

<div class="barre">
  <a class="btn btn-p" href={href}>Devis gratuit en 24&nbsp;h</a>
  <a class="btn btn-g" href={`tel:${contact.telLien}`} aria-label="Appeler Madaria"><Icon name="phone" class="i" /></a>
</div>

<script>
  const barre = document.querySelector<HTMLElement>('.barre');
  const seuil = document.querySelector('[data-seuil]');
  if (barre) {
    if (seuil && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        barre.classList.toggle('visible', !e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(seuil);
    } else {
      const maj = () => barre.classList.toggle('visible', scrollY > innerHeight * 0.6);
      maj();
      addEventListener('scroll', maj, { passive: true });
    }
  }
</script>
