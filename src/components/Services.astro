---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { services } from '../data/services';
---

<section id="services">
  <div class="wrap">
    <SectionHead label="Services" align="gauche">
      <Fragment slot="titre">
        Votre site internet,<br />
        de la première ligne au <span class="grad">dernier client</span>.
      </Fragment>
      Nous ne vendons pas des pages. Depuis Lyon, nous construisons des sites internet et des outils
      qui travaillent pour vous : rapides, mesurables, connectés à votre activité.
    </SectionHead>

    <div class="bento">
      {services.map((s) => (
        <div class:list={['glass', 'bcard', 'rv', { wide: s.wide }]}>
          <div class="spark"></div>
          <div class="ico"><Icon name={s.icon} /></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <div class="tags">{s.tags.map((t) => <b>{t}</b>)}</div>
          {s.href && <a class="text-link" href={s.href}>Découvrir la prestation →</a>}
        </div>
      ))}
    </div>
  </div>
</section>
