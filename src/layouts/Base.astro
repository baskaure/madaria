---
import '../styles/global.css';
import { site, contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  // Title pensé pour la requête « création de site internet » : mot-clé en tête,
  // différenciateur (7 jours), marque en fin. 56 caractères.
  title = 'Création de site internet à Lyon, livré en 7 jours | Madaria',
  description = "Agence de création de site internet à Lyon : site sur-mesure livré en 7 jours, dès 690 € HT, partout en France. Maquette offerte, devis gratuit sous 24 h.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://madaria.fr/#organisation',
      name: site.name,
      url: 'https://madaria.fr/',
      logo: 'https://madaria.fr/assets/07_logo_fond_sombre.svg',
      image: ogImage.href,
      description:
        "Agence digitale à Lyon : création de sites internet sur-mesure livrés en 7 jours, automatisations et outils métier, partout en France.",
      email: contact.email,
      telephone: '+33 6 99 68 19 57',
      priceRange: '€€',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '269 avenue Jean Jaurès',
        postalCode: '69007',
        addressLocality: 'Lyon',
        addressRegion: 'Auvergne-Rhône-Alpes',
        addressCountry: 'FR',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 45.764043, longitude: 4.835659 },
      areaServed: [
        { '@type': 'City', name: 'Lyon' },
        { '@type': 'Country', name: 'France' },
      ],
      sameAs: ['https://www.instagram.com/madaria_agency/'],
      knowsAbout: [
        'Création de site internet',
        'Site vitrine',
        'E-commerce',
        'Automatisation',
        'SEO',
        'Développement web',
      ],
      makesOffer: [
        {
          '@type': 'Offer',
          name: 'Site vitrine — formule Vitrine',
          price: '690',
          priceCurrency: 'EUR',
          description: "Site vitrine sur-mesure jusqu'à 5 pages, livré en 7 jours.",
        },
        {
          '@type': 'Offer',
          name: 'Site complet — formule Visibilité',
          price: '1490',
          priceCurrency: 'EUR',
          description: 'Site complet avec SEO technique, référencement local et rédaction des contenus.',
        },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://madaria.fr/#site',
      url: 'https://madaria.fr/',
      name: site.name,
      inLanguage: 'fr-FR',
      publisher: { '@id': 'https://madaria.fr/#organisation' },
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#07030F" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Madaria — création de site internet livré en 7 jours" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Sora:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
