---
import Base from '../layouts/Base.astro';
import { questionsAccueil as questions } from '../data/faq';
import Hero from '../components/Hero.astro';
import Realisations from '../components/Realisations.astro';
import Offres from '../components/Offres.astro';
import Methode from '../components/Methode.astro';
import Agence from '../components/Agence.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';

// Données structurées FAQ, générées depuis la même source que l'affichage.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.r },
  })),
};
---

<Base>
  <Hero />
  <Realisations />
  <Methode />
  <Offres />
  <Agence />
  <Faq />
  <Contact />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>
