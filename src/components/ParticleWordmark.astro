---
interface Props {
  /** Mot à dessiner en particules */
  text?: string;
}

const { text = 'MADARIA' } = Astro.props;
---

<div class="pw" id="pw" aria-hidden="true" data-text={text}>
  <canvas id="pw-canvas"></canvas>
</div>

<script>
  const host = document.getElementById('pw');
  const canvas = document.getElementById('pw-canvas') as HTMLCanvasElement | null;

  if (host && canvas) {
    const start = () => {
    const ctx = canvas.getContext('2d')!;

    // ---- réglages ----
    const PALETTE: number[][] = [
      [237, 233, 254], // lavande clair
      [196, 181, 253], // --glow
      [129, 140, 248], // violet
    ];
    const FORMATS = ['dot', 'dot', 'square'] as const;
    const SIZE_SMALL = [1.4, 2.8];
    const SIZE_BIG = [3, 4.2];
    const BIG_CHANCE = 0.07;
    const GAP = 6; // écart de la grille en px — augmenter allège le rendu
    /* En dessous de cette largeur, les lettres ne font plus que quelques
       points de large et le mot devient illisible : la grille se resserre
       (et les points rétrécissent d'autant pour garder la même densité). */
    const ETROIT = 560;
    const GAP_ETROIT = 3.6;
    const SPEED = 2;
    const SEED = 1337;
    const GAMMA = 0.8;
    const DUR = 8; // durée de la boucle, en secondes
    const TAU = Math.PI * 2;

    const mot = host.dataset.text ?? 'MADARIA';
    const WORDMARK =
      '<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="340" viewBox="0 0 1600 340">' +
      '<text x="800" y="272" text-anchor="middle" textLength="1540" lengthAdjust="spacing" ' +
      'fill="#fff" font-family="Sora, \'Helvetica Neue\', Helvetica, Arial, sans-serif" ' +
      `font-size="300" font-weight="800">${mot}</text>` +
      '</svg>';

    type Particule = {
      cx: number; cy: number; nx: number; ny: number;
      format: string; size: number; offset: number; mask: number;
    };

    // ---- bruit et champ de mouvement ----
    const noise = (x: number, y: number, t: number) => {
      const a = x + 0.7 * Math.sin(1.2 * y + t);
      const r = y + 0.7 * Math.cos(1.1 * x - t);
      return (
        Math.sin(1.3 * a + 0.6 * t) + Math.cos(1.5 * r - 0.5 * t) + Math.sin((a + r) * 0.9 + 0.3 * t)
      ) / 3;
    };

    /** Chute de flocons : renvoie l'intensité d'une particule à l'instant t. */
    const chute = (p: Particule, t: number) => {
      const swirl = 0.14 * noise(3 * p.nx, 3 * p.ny, 0.5 * t);
      const derive = 0.14 * Math.sin(0.8 * t + p.offset * TAU + 4 * p.ny) + swirl;
      const o = p.ny * 5 - t * 0.26 + p.offset * 5 + derive + 0.8 * p.nx;
      const s = o - Math.floor(o);
      return s < 0.4 ? 1 - s / 0.4 : 0;
    };

    const champ = (p: Particule, t: number) => {
      const bande = 0.35 + 0.65 * Math.pow(0.5 + 0.5 * Math.sin(3 * p.nx - 0.5 * t), 2);
      return {
        a: 0.14 + 0.86 * bande * Math.pow(chute(p, t), 1.8),
        p: 0.7 * p.offset,
      };
    };

    const melange = (v: number) => {
      const e = Math.max(0, Math.min(1, v)) * (PALETTE.length - 1);
      const i = Math.floor(e);
      const f = e - i;
      const a = PALETTE[i];
      const b = PALETTE[Math.min(PALETTE.length - 1, i + 1)];
      return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f];
    };

    /** Générateur pseudo-aléatoire déterministe : la grille est identique à chaque chargement. */
    const lcg = (seed: number) => {
      let e = seed >>> 0;
      return () => {
        e = (1664525 * e + 0x3c6ef35f) >>> 0;
        return e / 0xffffffff;
      };
    };

    // ---- lampe suivant le curseur ----
    const RAYON = 150; // portée de l'illumination, en px
    let sourisX = -1e5;
    let sourisY = -1e5;
    let lampe = 0; // intensité lissée, 0 → 1

    let particules: Particule[] = [];
    let masque: HTMLImageElement | null = null;
    let tNow = 0;
    let t0 = performance.now();
    let visible = true;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduit = motion.matches;
    let frame = 0;

    /** Échantillonne la luminance du mot pour savoir quelles particules l'habillent. */
    const construireMasque = (w: number, h: number) => {
      if (!masque?.width || !masque.height) return null;
      const off = document.createElement('canvas');
      off.width = w;
      off.height = h;
      const g = off.getContext('2d');
      if (!g) return null;
      const echelle = Math.min(w / masque.width, h / masque.height);
      const dw = masque.width * echelle;
      const dh = masque.height * echelle;
      g.drawImage(masque, (w - dw) / 2, (h - dh) / 2, dw, dh);
      let data: Uint8ClampedArray;
      try {
        data = g.getImageData(0, 0, w, h).data;
      } catch {
        return null;
      }
      return (x: number, y: number) => {
        const ix = Math.min(w - 1, Math.max(0, Math.round(x)));
        const iy = Math.min(h - 1, Math.max(0, Math.round(y)));
        const i = (iy * w + ix) * 4;
        const lum = (0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2]) / 255;
        return Math.pow(lum * (data[i + 3] / 255), GAMMA);
      };
    };

    const reconstruire = () => {
      const w = host.clientWidth;
      const h = host.clientHeight;
      if (!w || !h) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(w * dpr));
      canvas.height = Math.max(1, Math.floor(h * dpr));
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const echantillon = construireMasque(w, h);
      const rand = lcg(SEED);
      const pas = w < ETROIT ? GAP_ETROIT : GAP;
      const finesse = pas / GAP;
      const cols = Math.ceil(w / pas);
      const rows = Math.ceil(h / pas);
      const ox = (w - (cols - 1) * pas) / 2;
      const oy = (h - (rows - 1) * pas) / 2;

      particules = [];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const plage = rand() < BIG_CHANCE ? SIZE_BIG : SIZE_SMALL;
          const px = ox + x * pas;
          const py = oy + y * pas;
          particules.push({
            cx: px,
            cy: py,
            nx: cols > 1 ? x / (cols - 1) : 0.5,
            ny: rows > 1 ? y / (rows - 1) : 0.5,
            format: FORMATS[Math.floor(rand() * FORMATS.length)],
            size: (plage[0] + rand() * (plage[1] - plage[0])) * finesse,
            offset: rand(),
            mask: echantillon ? echantillon(px, py) : 1,
          });
        }
      }
    };

    const dessiner = (t: number) => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const portee = RAYON * RAYON;

      for (const p of particules) {
        const f = champ(p, t);
        let alpha = Math.max(0, Math.min(1, f.a));
        if (p.mask < 1) alpha = p.mask * (0.3 + 0.7 * alpha);

        // proximité du curseur : décroissance quadratique jusqu'à RAYON
        let lueur = 0;
        if (lampe > 0.002) {
          const dx = p.cx - sourisX;
          const dy = p.cy - sourisY;
          const d2 = dx * dx + dy * dy;
          if (d2 < portee) {
            const t0 = 1 - Math.sqrt(d2) / RAYON;
            lueur = t0 * t0 * lampe;
          }
        }

        // les points du mot s'allument franchement, ceux du fond juste assez
        // pour dessiner un halo autour du curseur
        if (lueur > 0) alpha = Math.min(1, alpha + lueur * (0.25 + 0.75 * p.mask));
        if (alpha <= 0.005) continue;

        let [r, g, b] = melange(f.p);
        if (lueur > 0) {
          const vers = lueur * 0.85;
          r += (255 - r) * vers;
          g += (255 - g) * vers;
          b += (255 - b) * vers;
        }
        ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
        const d = p.size * (1 + lueur * 0.85);
        const demi = d / 2;
        if (p.format === 'square') {
          ctx.fillRect(p.cx - demi, p.cy - demi, d, d);
        } else {
          ctx.beginPath();
          ctx.arc(p.cx, p.cy, demi, 0, TAU);
          ctx.fill();
        }
      }
    };

    let survol = false;

    const boucle = (now: number) => {
      frame = 0;
      if (!reduit && visible && !document.hidden) {
        lampe += ((survol ? 1 : 0) - lampe) * 0.12; // fondu entrée / sortie
        tNow = ((now - t0) / 1000) % DUR;
        dessiner(tNow * SPEED);
      }
      if (!reduit && visible && !document.hidden) frame = requestAnimationFrame(boucle);
    };

    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      sourisX = e.clientX - r.left;
      sourisY = e.clientY - r.top;
      survol = true;
    });
    host.addEventListener('pointerleave', () => {
      survol = false;
    });

    const img = new Image();
    img.onload = () => {
      masque = img;
      reconstruire();
      dessiner(tNow * SPEED);
    };
    img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(WORDMARK)}`;

    reconstruire();
    dessiner(0);
    if (!reduit) frame = requestAnimationFrame(boucle);

    let lastW = host.clientWidth;
    let lastH = host.clientHeight;
    new ResizeObserver(() => {
      if (host.clientWidth === lastW && host.clientHeight === lastH) return;
      lastW = host.clientWidth;
      lastH = host.clientHeight;
      reconstruire();
      dessiner(tNow * SPEED);
    }).observe(host);

    // On ne calcule rien tant que le footer n'est pas à l'écran.
    new IntersectionObserver(
      (entries) => {
        const on = !!entries[0]?.isIntersecting;
        if (on === visible) return;
        visible = on;
        if (visible) {
          t0 = performance.now() - tNow * 1000;
          if (!reduit && !document.hidden && !frame) frame = requestAnimationFrame(boucle);
        } else { cancelAnimationFrame(frame); frame = 0; }
      },
      { rootMargin: '120px' },
    ).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(frame); frame = 0; }
      else {
        t0 = performance.now() - tNow * 1000;
        if (visible && !reduit && !frame) frame = requestAnimationFrame(boucle);
      }
    });
    motion.addEventListener('change', e => {
      reduit = e.matches;
      cancelAnimationFrame(frame); frame = 0;
      if (!reduit && visible && !document.hidden) frame = requestAnimationFrame(boucle);
      else dessiner(tNow * SPEED);
    });
    };
    const activation = new IntersectionObserver(entries => {
      if (entries.some(entry => entry.isIntersecting)) { activation.disconnect(); start(); }
    }, { rootMargin: '120px' });
    activation.observe(host);
  }
</script>
