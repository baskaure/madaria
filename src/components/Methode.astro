---
import { etapes } from '../data/methode';
---

<section id="methode">
  <div class="wrap msplit">
    <div class="mintro rv">
      <div class="lab">Méthode</div>
      <h2>
        Votre site internet en quatre étapes.<br /><span class="grad">Sept jours.</span>
      </h2>
      <p>
        Un cadre clair, un point chaque jour, un accès permanent à l'avancement. Vous savez
        toujours où en est votre projet.
      </p>
      <div class="mjours">
        <b>J+7</b>
        <span>votre site est en ligne, formation comprise</span>
      </div>
    </div>

    <div class="tl">
      <div class="tlfill"></div>
      {etapes.map((e) => (
        <div class="tnode">
          <div class="tdot">{e.num}</div>
          <div class="tbody">
            <div class="h">
              <h3>{e.titre}</h3>
              <span class="t">{e.delai}</span>
            </div>
            <p>{e.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Frise pilotée par le défilement : --tlp (0 → 1) est la part du rail déjà
  // passée sous la ligne de lecture (deux tiers de l'écran) ; le trait lumineux
  // se remplit d'autant, et chaque étape s'allume quand la tête du trait
  // atteint son losange. Tout est recalculé dans les deux sens du défilement.
  const tl = document.querySelector<HTMLElement>('.tl');
  const nodes = Array.from(document.querySelectorAll<HTMLElement>('.tnode'));
  const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tl && !calme) {
    let raf = 0;
    const maj = () => {
      raf = 0;
      const r = tl.getBoundingClientRect();
      const repere = innerHeight * 0.66;
      const p = Math.min(1, Math.max(0, (repere - r.top) / r.height));
      tl.style.setProperty('--tlp', p.toFixed(3));
      tl.classList.toggle('termine', p >= 1);
      // hauteur du trait en pixels, même formule que le CSS : 8px de marge puis (100% - 16px) × p
      const trait = 8 + (r.height - 16) * p;
      nodes.forEach((n) => n.classList.toggle('atteint', n.offsetTop + 16 <= trait));
    };
    const demande = () => {
      if (!raf) raf = requestAnimationFrame(maj);
    };
    addEventListener('scroll', demande, { passive: true });
    addEventListener('resize', demande);
    maj();
  } else {
    nodes.forEach((n) => n.classList.add('atteint'));
  }
</script>
