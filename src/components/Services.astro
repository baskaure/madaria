---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { services } from '../data/services';
---

<section class="sec" id="services">
  <div class="wrap">
    <SectionHead label="Services">
      <Fragment slot="titre">Le site d'abord. Et tout ce qui tourne autour.</Fragment>
      <p>Depuis Lyon, nous construisons des sites et des outils qui travaillent pour vous, rapides et mesurables.</p>
    </SectionHead>
    <div class="srv rv">
      {services.map((s, i) => (
        <div class="srow">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {s.href
            ? <a class="tlink" href={s.href}>En savoir plus<Icon name="arrow" class="i" /></a>
            : <a class="tlink" href="#contact">Nous écrire<Icon name="arrow" class="i" /></a>}
        </div>
      ))}
    </div>
  </div>
</section>
