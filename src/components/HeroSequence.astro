---
/**
 * Séquence du hero : dans le cadre d'écran, un site se construit en une
 * douzaine de secondes, pour montrer la promesse « en ligne en 7 jours ».
 *
 * Les quatre phases reprennent la méthode (`data/methode.ts`) :
 *   Cadrage · Jour 1           carte de brief, trois champs tapés
 *   Design · Jour 2 → 3        wireframe gris posé bloc par bloc, puis mis
 *                              aux couleurs du client
 *   Développement · Jour 3 → 6 extraits réels de son code pendant que la
 *                              capture du site remplace la maquette
 *   Mise en ligne · Jour 7     URL, badge « En ligne », puis la fin propre au
 *                              projet (notification ou leads qui arrivent)
 *
 * Deux projets en boucle (`data/sequence.ts`), un onglet chacun. Tout est
 * piloté par la Web Animations API : chaque élément reçoit UNE animation qui
 * couvre toute la durée du projet (ses étapes en offsets), toutes démarrent
 * ensemble. Mettre en pause, reprendre ou sauter à l'état final revient donc
 * à agir sur la même horloge pour toutes.
 *
 * A remplacé la vitrine vidéo KlientMap le 29/09/2026 (source archivée dans
 * `medias-en-reserve/`).
 */
import { projets } from '../data/sequence';
import { etapes } from '../data/methode';

const premier = projets[0];
const pc = (v: number) => `${v}%`;
const boite = (b: { x: number; y: number; w: number; h: number }) =>
  `left:${pc(b.x)};top:${pc(b.y)};width:${pc(b.w)};height:${pc(b.h)}`;
---

<div class="mockwrap rv sq" data-sq>
  <div class="proj" aria-hidden="true"><i></i></div>

  <div class="mockframe">
    <div class="mock glass">
      {/* barre des cartes Réalisations (`.barre`) ; ses règles visent tout
          `span` et tout `i` descendants, d'où les `em`/`b` à l'intérieur */}
      <div class="barre">
        <i></i><i></i><i></i>
        <div class="sq-url">
          <em class="sq-pre" data-u-pre>préproduction</em>
          <em class="sq-prod" data-u-prod><b data-u-hote>{premier.url}</b><b data-u-chemin></b></em>
        </div>
        {/* phase en cours : dans la barre sur ordinateur, dans l'écran sur mobile */}
        <p class="sq-phases" aria-hidden="true">
          {etapes.map((e) => (
            <em class="sq-phase" data-phase><b>{e.num}</b>{e.titre}<u>{e.delai}</u></em>
          ))}
        </p>
        <b class="sq-live" data-live><em><s data-live-on></s></em>En ligne</b>
      </div>
      <div class="sq-jours" aria-hidden="true"><i data-avance></i></div>

      <div class="sq-ecran" id="sq-ecran" role="tabpanel" aria-labelledby={`sq-onglet-${premier.id}`} data-ecran>
        {projets.map((p, i) => (
          <div
            class="sq-projet"
            data-projet={p.id}
            data-nom={p.nom}
            data-url={p.url}
            data-chemin={p.chemin ?? ''}
            data-fin={p.fin.type}
            hidden={i !== 0}
            style={p.couleurs}
          >
            <div class="sq-page" data-page>
              {(['gris', 'couleur'] as const).map((couche) => (
                <div class={`sq-wire sq-${couche}`} data-wire={couche} aria-hidden="true">
                  {p.blocs.map((b) => <i class={`b-${b.role}`} style={boite(b)} />)}
                </div>
              ))}
              <i class="sq-scan" data-scan aria-hidden="true" />
              <img
                class="sq-shot"
                data-shot
                src={p.capture.src}
                srcset={`${p.capture.src1x} 1440w, ${p.capture.src} 2880w`}
                sizes="(max-width: 760px) 200vw, min(1166px, 100vw)"
                width="2880"
                height="1440"
                alt={p.capture.alt}
                loading="lazy"
                decoding="async"
              />
              {p.fin.type === 'leads' && (
                <div class="sq-app" data-app>
                  <img
                    src={p.fin.src}
                    srcset={`${p.fin.src1x} ${p.fin.largeur / 2}w, ${p.fin.src} ${p.fin.largeur}w`}
                    sizes="(max-width: 760px) 200vw, min(1166px, 100vw)"
                    width={p.fin.largeur}
                    height={p.fin.hauteur}
                    alt={p.fin.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  {p.fin.colonnes.map((c) => <i class="sq-vide" style={`${boite(c)};background:${c.fond}`} />)}
                  {p.fin.cartes.map((c) => (
                    <span
                      class="sq-carte"
                      data-carte={c.rang}
                      style={`clip-path:inset(${c.y}% ${100 - c.x - c.w}% ${100 - c.y - c.h}% ${c.x}% round 0.6%)`}
                      aria-hidden="true"
                    >
                      <img src={p.fin.src} srcset={`${p.fin.src1x} ${p.fin.largeur / 2}w, ${p.fin.src} ${p.fin.largeur}w`}
                        sizes="(max-width: 760px) 200vw, min(1166px, 100vw)" width={p.fin.largeur} height={p.fin.hauteur}
                        alt="" loading="lazy" decoding="async" />
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="sq-brief glass" data-brief>
              <p class="sq-tete"><span>Brief</span><em>Appel de 15 min</em></p>
              <dl>
                {p.brief.map((c) => (
                  <div class={c.mobile ? undefined : 'sq-opt'}>
                    <dt>{c.label}</dt>
                    <dd><span data-frappe style={`--n:${c.valeur.length}`}>{c.valeur}</span></dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="sq-code sq-sombre" data-code aria-hidden="true">
              <p class="sq-tete"><span>{p.dossier}</span></p>
              <div class="sq-code-vue">
                <ol data-lignes>
                  {p.code.map((l) => (
                    <li class:list={[{ 'sq-fichier': !l.n, 'sq-opt': !l.mobile }]} data-ligne>
                      <span>{l.n ?? ''}</span><code>{l.code}</code>
                    </li>
                  ))}
                </ol>
              </div>
            </div>

            {p.fin.type === 'notification' && (
              <div class="sq-notif sq-sombre" data-notif>
                <span class="sq-icone" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></svg>
                </span>
                <span class="sq-notif-txt">
                  <b>{p.fin.titre}</b>
                  <span>{p.fin.detail}</span>
                </span>
                <em>À l'instant</em>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="demo-actions sq-actions">
    <div class="sq-onglets" role="tablist" aria-label="Projets présentés">
      {projets.map((p, i) => (
        <button
          type="button"
          role="tab"
          id={`sq-onglet-${p.id}`}
          aria-controls="sq-ecran"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-onglet={i}
        >
          <b>{p.nom}</b><em>Offre {p.offre}</em>
        </button>
      ))}
    </div>
    <button type="button" class="sq-pause" data-pause aria-pressed="false" aria-label="Mettre l'animation en pause">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="sq-ico-pause" d="M9 6v12M15 6v12" /><path class="sq-ico-lire" d="M8 5.5v13l11-6.5z" /></svg>
    </button>
    <a class="text-link" data-lien href={`/realisations/${premier.id}/`}>Découvrir le projet {premier.nom} →</a>
  </div>

  <!-- sans JavaScript : l'état final du premier projet, immobile -->
  <noscript><style>
    .sq-shot,.sq-prod,.sq-prod b,.sq-live,.sq-live s,.sq-notif,.sq-phase:last-child{opacity:1!important;clip-path:none!important;transform:none!important}
    .sq-pause{display:none!important}
  </style></noscript>
</div>

<script>
  type Etape = [number, Keyframe, string?];

  const racine = document.querySelector<HTMLElement>('[data-sq]');

  if (racine) {
    const $ = <T extends Element = HTMLElement>(sel: string, dans: ParentNode = racine) => dans.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string, dans: ParentNode = racine) =>
      Array.from(dans.querySelectorAll<T>(sel));

    const calme = matchMedia('(prefers-reduced-motion: reduce)');
    const etroit = matchMedia('(max-width: 760px)');
    const projets = $$('[data-projet]');
    const onglets = $$<HTMLButtonElement>('[data-onglet]');
    const bouton = $<HTMLButtonElement>('[data-pause]')!;
    const lien = $<HTMLAnchorElement>('[data-lien]')!;
    const ecran = $('[data-ecran]')!;
    const hote = $('[data-u-hote]')!;
    const chemin = $('[data-u-chemin]')!;

    // Repères de la séquence, en millisecondes. Mêmes pour les deux projets
    // jusqu'à la mise en ligne ; seule la fin (notification ou leads) diffère.
    const T = { design: 2400, dev: 5200, ligne: 8600, fin: 9900 } as const;
    const FIN = { notification: 2500, leads: 3500 } as const;
    const SORTIE = 600;
    const SOUPLE = 'cubic-bezier(.16,1,.3,1)';
    const RESSORT = 'cubic-bezier(.34,1.4,.5,1)';

    /** Lignes réellement affichées (le mobile en masque une partie). */
    const affiche = (els: HTMLElement[]) => els.filter((el) => getComputedStyle(el).display !== 'none');

    let actif = 0;
    let anims: Animation[] = [];
    let arret = 0; // temps de l'état final (juste avant le fondu de sortie)
    let visible = false;
    let pauseVoulue = false;

    function construire(i: number) {
      anims.forEach((a) => a.cancel());
      anims = [];
      const p = projets[i];
      const fin = p.dataset.fin as keyof typeof FIN;
      const D = T.fin + FIN[fin] + SORTIE;
      arret = D - SORTIE;

      /** Une animation par élément sur toute la durée D ; les étapes deviennent des offsets. */
      const piste = (el: Element | null, etapes: Etape[], easing = SOUPLE) => {
        if (!el) return;
        const pts = [...etapes];
        if (pts[0][0] > 0) pts.unshift([0, pts[0][1]]);
        if (pts[pts.length - 1][0] < D) pts.push([D, pts[pts.length - 1][1]]);
        const a = el.animate(
          pts.map(([t, k, e]) => ({ ...k, offset: Math.min(1, t / D), easing: e ?? easing })),
          { duration: D, fill: 'both' },
        );
        a.pause();
        anims.push(a);
      };
      const cache = { opacity: 0 };
      const vu = { opacity: 1 };

      // Horloge : un effet sans cible, dont la fin enchaîne sur l'autre projet.
      const horloge = new Animation(new KeyframeEffect(null, null, { duration: D }));
      horloge.onfinish = () => lancer((actif + 1) % projets.length);
      anims.push(horloge);

      // ---- repères communs : phase en cours, jours écoulés, barre d'adresse ----
      const debuts = [0, T.design, T.dev, T.ligne, arret];
      $$('[data-phase]').forEach((el, k) => {
        const a = debuts[k], b = debuts[k + 1];
        const bas = { opacity: 0, transform: 'translateY(40%)' };
        const haut = { opacity: 0, transform: 'translateY(-40%)' };
        const ici = { opacity: 1, transform: 'none' };
        piste(el, k === 3
          ? [[a, bas], [a + 350, ici], [arret, ici], [D, haut]]
          : [[a, bas], [a + 350, ici], [b, ici], [b + 250, haut]]);
      });
      piste($('[data-avance]'), [[0, { transform: 'scaleX(0)' }], [T.ligne, { transform: 'scaleX(1)' }]], 'linear');
      piste($('[data-u-pre]'), [[T.dev, cache], [T.dev + 250, vu], [T.ligne, vu], [T.ligne + 150, cache]]);
      const typo = (el: HTMLElement, t: number, duree: number) => {
        const n = Math.max(1, el.textContent!.length);
        piste(el, [
          [t, { clipPath: 'inset(0 100% 0 0)' }],
          [t + duree, { clipPath: 'inset(0 0% 0 0)' }, 'linear'],
        ], `steps(${n}, end)`);
      };
      piste($('[data-u-prod]'), [[T.ligne + 100, vu], [arret, vu], [D, cache]]);
      typo(hote, T.ligne + 100, 600);
      typo(chemin, T.fin, 300);
      piste($('[data-live]'), [[T.ligne + 700, { opacity: 0.4 }], [T.ligne + 950, vu], [arret, vu], [D, { opacity: 0.4 }]]);
      piste($('[data-live-on]'), [
        [T.ligne + 700, { opacity: 0, transform: 'scale(.4)' }],
        [T.ligne + 950, { opacity: 1, transform: 'scale(1.35)' }],
        [T.ligne + 1300, { opacity: 1, transform: 'scale(1)' }],
        [arret, { opacity: 1, transform: 'scale(1)' }],
        [D, { opacity: 0, transform: 'scale(1)' }],
      ]);

      // ---- 1. Cadrage : la carte de brief, ses champs tapés un à un ----
      const brief = $('[data-brief]', p);
      piste(brief, [
        [150, { opacity: 0, transform: 'translate(-50%, -46%) scale(.96)' }],
        [600, { opacity: 1, transform: 'translate(-50%, -50%) scale(1)' }],
        [T.design, { opacity: 1, transform: 'translate(-50%, -50%) scale(1)' }],
        [T.design + 350, { opacity: 0, transform: 'translate(-50%, -56%) scale(.98)' }],
      ]);
      affiche($$('dl > div', brief)).forEach((champ, j) => typo($('[data-frappe]', champ)!, 700 + j * 550, 450));

      // ---- 2. Design : blocs gris en cascade, puis balayage aux couleurs du client ----
      $$('[data-wire="gris"] > i', p).forEach((b, j) => {
        const t = T.design + 150 + Math.min(j, 18) * 55;
        piste(b, [[t, { opacity: 0, transform: 'scale(.9)' }], [t + 380, { opacity: 1, transform: 'none' }]]);
      });
      piste($('[data-wire="gris"]', p), [[T.dev + 2600, vu], [T.dev + 2700, cache]]);
      piste($('[data-wire="couleur"]', p), [
        [T.design + 1700, { clipPath: 'inset(0 100% 0 0)' }],
        [T.design + 2600, { clipPath: 'inset(0 0% 0 0)' }],
      ], 'cubic-bezier(.65,0,.35,1)');

      // ---- 3. Développement : la capture remplace la maquette, le code défile ----
      const balaye = 'cubic-bezier(.45,0,.25,1)';
      piste($('[data-shot]', p), [
        [T.dev + 400, { clipPath: 'inset(0 0 100% 0)' }],
        [T.dev + 3000, { clipPath: 'inset(0 0 0% 0)' }],
      ], balaye);
      piste($('[data-scan]', p), [
        [T.dev + 300, { opacity: 0, top: '0%' }],
        [T.dev + 400, { opacity: 1, top: '0%' }, balaye],
        [T.dev + 3000, { opacity: 1, top: '100%' }],
        [T.dev + 3150, { opacity: 0, top: '100%' }],
      ], 'linear');

      const code = $('[data-code]', p)!;
      piste(code, [
        [T.dev + 100, { opacity: 0, transform: 'translateY(8%)' }],
        [T.dev + 450, { opacity: 1, transform: 'none' }],
        [T.ligne - 300, { opacity: 1, transform: 'none' }],
        [T.ligne, { opacity: 0, transform: 'translateY(-4%)' }],
      ]);
      const lignes = affiche($$('[data-ligne]', code));
      const vues = Number(getComputedStyle(code).getPropertyValue('--lignes')) || 4;
      const pas = 2700 / lignes.length;
      // le panneau montre `vues` lignes : chaque ligne suivante le fait monter d'un cran
      const cran = (k: number) => ({ transform: `translateY(${-k * 1.7}em)` });
      const defile: Etape[] = [[0, cran(0)]];
      lignes.forEach((l, j) => {
        const t = T.dev + 400 + j * pas;
        piste(l, [[t, { opacity: 0, transform: 'translateX(-.6em)' }], [t + 260, { opacity: 1, transform: 'none' }]]);
        if (j >= vues) defile.push([t, cran(j - vues)], [t + 260, cran(j - vues + 1)]);
      });
      if (defile.length > 1) piste($('[data-lignes]', code), defile);

      // ---- 4. Mise en ligne : la fin propre au projet ----
      if (fin === 'notification') {
        piste($('[data-notif]', p), [
          [T.fin, { opacity: 0, transform: 'translateY(40%)' }],
          [T.fin + 650, { opacity: 1, transform: 'none' }, RESSORT],
        ], RESSORT);
      } else {
        // l'appli remplace la landing, puis les leads arrivent rangée par rangée
        piste($('[data-app]', p), [[T.fin, cache], [T.fin + 500, vu]]);
        // sur mobile le cadre ne montre que le début de la page : on se cale à gauche
        piste($('[data-page]', p), [
          [T.fin, { left: 'calc((100cqw - 200cqh) / 2)' }],
          [T.fin + 700, { left: '0px' }],
        ]);
        $$('[data-carte]', p).forEach((c) => {
          const t = T.fin + 600 + Number(c.dataset.carte) * 300;
          piste(c, [[t, { opacity: 0, transform: 'translateY(2.5cqh)' }], [t + 420, { opacity: 1, transform: 'none' }]]);
        });
      }

      piste(p, [[arret, vu], [D, cache]], 'ease-in');
    }

    /**
     * Captures en `loading="lazy"`, mais Chromium (Chrome, Brave) ne charge
     * jamais une image entièrement masquée par `clip-path` : c'est l'état de
     * départ de la capture, qui restait donc vide. Dès que le bloc est à
     * l'écran, celles du projet en cours et du suivant passent en immédiat.
     */
    const charger = (i: number) => {
      for (const k of [i, (i + 1) % projets.length])
        $$<HTMLImageElement>('img', projets[k]).forEach((img) => (img.loading = 'eager'));
    };

    const jouer = () => anims.forEach((a) => a.play());
    const suspendre = () => anims.forEach((a) => a.pause());
    const maj = () => {
      if (calme.matches) return;
      if (visible && !pauseVoulue && !document.hidden) jouer();
      else suspendre();
    };

    function lancer(i: number, t = 0) {
      actif = i;
      projets.forEach((p, k) => (p.hidden = k !== i));
      const p = projets[i];
      hote.textContent = p.dataset.url || '';
      chemin.textContent = p.dataset.chemin || '';
      onglets.forEach((o, k) => {
        o.setAttribute('aria-selected', String(k === i));
        o.tabIndex = k === i ? 0 : -1;
      });
      ecran.setAttribute('aria-labelledby', onglets[i].id);
      lien.href = `/realisations/${p.dataset.projet}/`;
      lien.textContent = `Découvrir le projet ${p.dataset.nom} →`;

      construire(i);
      if (visible || calme.matches) charger(i);
      if (calme.matches) {
        // animations réduites : l'état final, immobile
        anims.forEach((a) => { a.currentTime = arret; a.pause(); });
        return;
      }
      anims.forEach((a) => (a.currentTime = t));
      maj();
    }

    const majBouton = () => {
      bouton.setAttribute('aria-pressed', String(pauseVoulue));
      bouton.setAttribute('aria-label', pauseVoulue ? "Reprendre l'animation" : "Mettre l'animation en pause");
    };

    onglets.forEach((o, i) =>
      o.addEventListener('click', () => {
        pauseVoulue = false;
        majBouton();
        lancer(i);
      }),
    );
    // flèches du clavier dans la liste d'onglets (motif ARIA « tabs »)
    $('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const sens = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!sens) return;
      e.preventDefault();
      const i = (actif + sens + onglets.length) % onglets.length;
      onglets[i].focus();
      onglets[i].click();
    });

    bouton.addEventListener('click', () => {
      pauseVoulue = !pauseVoulue;
      majBouton();
      maj();
    });
    bouton.hidden = calme.matches;

    new IntersectionObserver(
      (entrees) => {
        visible = entrees.some((e) => e.isIntersecting);
        if (visible) charger(actif);
        maj();
      },
      { threshold: 0.25 },
    ).observe(ecran);
    document.addEventListener('visibilitychange', maj);
    calme.addEventListener('change', () => {
      bouton.hidden = calme.matches;
      lancer(actif);
    });
    // le mobile masque des champs et des lignes : on reconstruit au même instant
    etroit.addEventListener('change', () => lancer(actif, Number(anims[0]?.currentTime) || 0));

    lancer(0);
  }
</script>

<style>
  /* Variables propres au bloc. Le site n'a de variables que pour ses
     couleurs : les rayons et la pile mono reprennent ceux de `.cadre` et
     `.barre` (global.css), les teintes sont des mélanges de ses couleurs. */
  .sq {
    --sq-mono: ui-monospace, 'SF Mono', Menlo, monospace;
    --sq-r: 14px;
    --sq-r-s: 5px;
    --sq-gris: color-mix(in srgb, var(--fg) 15%, transparent);
    --sq-gris-fort: color-mix(in srgb, var(--fg) 24%, transparent);
    --sq-marge: 1.6cqw;
  }

  /* ---- barre de navigateur : celle des cartes Réalisations, à l'échelle ---- */
  .barre {
    height: 40px;
    padding: 0 16px;
    gap: 8px;
    font-size: 12px;
  }
  .barre > i {
    width: 10px;
    height: 10px;
  }
  .sq-url {
    position: relative;
    margin-left: 10px;
    flex: 1;
    min-width: 0;
    height: 24px;
    max-width: 420px;
    font-family: var(--sq-mono);
    font-size: 11.5px;
    color: var(--mut);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    border-radius: var(--sq-r-s);
    overflow: hidden;
  }
  .sq-url em {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 0 10px;
    font-style: normal;
    white-space: nowrap;
  }
  .sq-pre {
    color: var(--faint);
    opacity: 0;
  }
  .sq-prod {
    color: var(--fg);
    opacity: 0;
  }
  .sq-prod b {
    display: inline-block;
    font-weight: 400;
    clip-path: inset(0 100% 0 0);
  }
  .sq-live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 10px 3px 8px;
    border: 1px solid var(--line2);
    border-radius: 100px;
    font-family: var(--sq-mono);
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    white-space: nowrap;
    opacity: 0.4;
  }
  .sq-live em {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line2);
  }
  .sq-live s {
    position: absolute;
