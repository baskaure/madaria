---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/site';
---

<Base noindex title="Merci pour votre demande | Madaria" description="Les prochaines étapes de votre demande de devis auprès de Madaria.">
  <section class="ph">
    <div class="wrap">
      <span class="lab">Demande envoyée</span>
      <h1>Merci, <span class="acc">c'est bien reçu.</span></h1>
      <p class="chapo">On revient vers vous sous 24&nbsp;h pour préciser votre besoin, votre budget et votre calendrier.</p>
      <p class="chapo">Besoin d'ajouter quelque chose ? Écrivez à <a href={`mailto:${contact.email}`}>{contact.email}</a> ou appelez le <a href={`tel:${contact.telLien}`}>{contact.tel}</a>.</p>
      <div class="hcta"><a class="btn btn-p" href="/">Retour à l'accueil<Icon name="arrow" class="i" /></a><a class="btn btn-g" href="/realisations/">Voir les réalisations</a></div>
    </div>
  </section>
</Base>
