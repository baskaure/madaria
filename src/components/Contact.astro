---
import { contact, budgets } from '../data/site';

const champs = [
  { id: 'n-nom', name: 'nom', label: 'Nom', type: 'text', placeholder: 'Jean Dupont', required: true, auto: 'name' },
  { id: 'n-mail', name: 'email', label: 'Email', type: 'email', placeholder: 'jean@entreprise.fr', required: true, auto: 'email' },
  { id: 'n-tel', name: 'telephone', label: 'Téléphone', type: 'tel', placeholder: '06 12 34 56 78', required: false, auto: 'tel' },
  { id: 'n-soc', name: 'societe', label: 'Société', type: 'text', placeholder: 'Entreprise SARL', required: false, auto: 'organization' },
];

const coordonnees = [
  { label: 'Mail', valeur: contact.email, lien: `mailto:${contact.email}` },
  { label: 'Téléphone', valeur: contact.tel, lien: `tel:${contact.telLien}` },
  { label: 'Zone', valeur: contact.zone },
];
---

<section id="contact">
  <div class="wrap cgrid">
    <div class="glass cinfo rv">
      <h2>Parlons de votre projet.<br /><span class="grad">Le devis est offert.</span></h2>
      <p>
        Un échange de 30 minutes, sans engagement, pour évaluer ce qui est faisable, à quel prix et
        en combien de temps. Nous sommes basés à Lyon et accompagnons des clients partout en France.
      </p>
      {coordonnees.map((c) => (
        <div class="crow">
          <span>{c.label}</span>
          {c.lien ? <a href={c.lien}>{c.valeur}</a> : <span>{c.valeur}</span>}
        </div>
      ))}
      <div class="crow">
        <span>Délai</span><span style="color:#6EE7A8">{contact.delai}</span>
      </div>
    </div>

    <form
      class="glass rv"
      id="form"
      name="contact"
      method="POST"
      action="/"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      novalidate
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="pot" hidden aria-hidden="true">
        <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>
      {champs.map((c) => (
        <div class="f">
          <label for={c.id}>{c.label}</label>
          <input
            id={c.id}
            name={c.name}
            type={c.type}
            placeholder={c.placeholder}
            required={c.required}
            autocomplete={c.auto}
          />
        </div>
      ))}

      {/* pleine largeur : avec quatre champs à mi-largeur au-dessus, le budget
          resterait seul sur sa ligne */}
      <div class="f full">
        <label for="n-bud">Budget</label>
        <select id="n-bud" name="budget">
          {budgets.map((b) => <option>{b}</option>)}
        </select>
      </div>

      <div class="f full">
        <label for="n-msg">Votre projet</label>
        <textarea
          id="n-msg"
          name="message"
          placeholder="Décrivez en quelques lignes ce que vous voulez construire…"
          required></textarea>
      </div>

      <div class="f full">
        <button type="submit" class="btn btn-p">Envoyer la demande</button>
        <div class="fmsg" id="fmsg" role="status" aria-live="polite"></div>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('form') as HTMLFormElement | null;
  const msg = document.getElementById('fmsg');

  const dire = (texte: string, ok: boolean) => {
    if (!msg) return;
    msg.style.color = ok ? '#6EE7A8' : '#FCA5A5';
    msg.textContent = texte;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nom = String(data.get('nom') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    if (!nom || !email || !message) {
      dire('Nom, email et description sont requis.', false);
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      dire('Adresse email invalide.', false);
      return;
    }
    // Le téléphone reste facultatif : on ne le vérifie que s'il est renseigné,
    // et assez largement pour accepter les formats français et internationaux.
    const tel = String(data.get('telephone') ?? '').trim();
    if (tel && !/^\+?[\d\s().-]{9,20}$/.test(tel)) {
      dire('Numéro de téléphone invalide.', false);
      return;
    }

    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // En développement, le serveur répond 200 au POST sans rien traiter :
    // afficher un succès ici serait mensonger. Seul le site déployé enregistre.
    if (import.meta.env.DEV) {
      dire('Mode développement : rien n’est envoyé. Testez sur le site déployé.', false);
      return;
    }

    if (bouton) bouton.disabled = true;
    dire('Envoi en cours…', true);

    try {
      // Netlify Forms : POST url-encodé vers la page elle-même.
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      });
      if (!res.ok) throw new Error(String(res.status));
      dire('Demande envoyée — réponse sous 24 h. Merci !', true);
      form.reset();
    } catch {
      dire("L'envoi a échoué. Écrivez-nous directement : contact@madaria.fr", false);
    } finally {
      if (bouton) bouton.disabled = false;
    }
  });
</script>
