---
import Icon from './Icon.astro';
import Mur from './Mur.astro';
import { offres } from '../data/offres';

const entree = offres[0];
---

<section class="hero">
  <Mur />
  <div class="wrap">
    <div class="htxt">
      <div class="pill"><b>{entree.prix}&nbsp;€/mois</b>Création incluse, rien à payer au départ</div>
      <h1>Votre site internet en ligne en 7&nbsp;jours. <span class="acc">Pas dans trois mois.</span></h1>
      <p class="lead">
        Madaria conçoit vos <strong>sites internet</strong>, <strong>automatisations</strong> et <strong>outils métier</strong>.
        Un interlocuteur direct, du premier échange à la mise en ligne.
      </p>
      <div class="hcta" data-seuil>
        <a class="btn btn-p" href="#contact">Recevoir mon devis en 24&nbsp;h<Icon name="arrow" class="i" /></a>
        <a class="btn btn-g" href="#realisations">Voir les réalisations</a>
      </div>
      <div class="preuves">
        <span><Icon name="check" class="i" />Maquette validée avant le code</span>
        <span><Icon name="check" class="i" />Nom de domaine à votre nom</span>
        <span><Icon name="check" class="i" />Basé à Lyon, partout en France</span>
      </div>
    </div>
  </div>
</section>
