---
import SectionHead from './SectionHead.astro';
import { etapes } from '../data/methode';
---

<section id="methode">
  <div class="wrap">
    <SectionHead label="Méthode">
      <Fragment slot="titre">
        Votre site internet en quatre étapes.<br /><span class="grad">Sept jours.</span>
      </Fragment>
      Un cadre clair, un point chaque jour, un accès permanent à l'avancement. Vous savez toujours
      où en est votre projet.
    </SectionHead>

    <div class="tl">
      <div class="tlfill"></div>
      {etapes.map((e) => (
        <div class="tnode">
          <div class="tdot">{e.num}</div>
          <div class="glass tbody">
            <div class="h">
              <h3>{e.titre}</h3>
              <span class="t">{e.delai}</span>
            </div>
            <p>{e.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tl = document.querySelector<HTMLElement>('.tl');
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (tl && !reduit) {
    const noeuds = Array.from(tl.querySelectorAll<HTMLElement>('.tnode'));
    let planifie = false;

    const actualiser = () => {
      planifie = false;
      const r = tl.getBoundingClientRect();
      // ligne de lecture : un peu sous le milieu de l'écran
      const ligne = window.innerHeight * 0.62;
      const p = Math.max(0, Math.min(1, (ligne - r.top) / (r.height || 1)));
      tl.style.setProperty('--tlp', String(p));
      tl.classList.toggle('termine', p >= 1);

      for (const n of noeuds) {
        const dot = n.querySelector<HTMLElement>('.tdot');
        if (!dot) continue;
        const d = dot.getBoundingClientRect();
        n.classList.toggle('atteint', d.top + d.height / 2 <= ligne);
      }
    };

    const demander = () => {
      if (planifie) return;
      planifie = true;
      requestAnimationFrame(actualiser);
    };

    actualiser();
    window.addEventListener('scroll', demander, { passive: true });
    window.addEventListener('resize', demander, { passive: true });
  }
</script>
