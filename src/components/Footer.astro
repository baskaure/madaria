---
import Logo from './Logo.astro';
import ParticleWordmark from './ParticleWordmark.astro';
import { footerColumns } from '../data/site';
import { secteurs } from '../data/secteurs';

const annee = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="fcols">
      <div>
        <a class="sh-brand" href="/#top"><Logo gradientId="gn-footer" />MADARIA</a>
        <p>
          Agence web basée à Lyon. Sites internet, automatisations et développement sur-mesure,
          partout en France.
        </p>
      </div>
      {footerColumns.map((col) => (
        <div>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>

    <!-- Métiers : chaque lien mène à sa page métier, c'est le maillage interne
         le plus utile du site. Présent sur toutes les pages : ne pas retirer. -->
    <div class="fmetiers" id="secteurs">
      <h2>Un site pensé pour votre métier</h2>
      <nav aria-label="Sites par métier">
        {secteurs.map((s) => <a href={`/site-internet/${s.slug}/`}>{s.nom}</a>)}
        <a href="/#contact">Autre métier&nbsp;? Parlons-en</a>
      </nav>
    </div>

    <ParticleWordmark text="MADARIA" />

    <div class="fbas">
      <span>© {annee} Madaria</span>
      <span>
        <a href="/mentions-legales/">Mentions légales</a>{' · '}
        <a href="/confidentialite/">Confidentialité</a>{' · '}
        <a href="/cgv/">CGV</a>
      </span>
    </div>
  </div>
</footer>
