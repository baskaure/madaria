---
import SectionHead from './SectionHead.astro';
import OfferTerms from './OfferTerms.astro';
import { offres } from '../data/offres';
---

<section id="offres">
  <div class="wrap">
    <SectionHead label="Offres">
      <Fragment slot="titre">
        Le prix de votre site internet,<br />annoncé <span class="grad">avant</span> de commencer.
      </Fragment>
      Maquette incluse et validée avant développement. Le devis précise les pages, les options et les frais récurrents éventuels.
    </SectionHead>

    <div class="plans">
      {offres.map((o) => (
        <div class:list={['glass', 'plan', 'rv', { feat: o.feat }]}>
          <div class="pn">
            <span>{o.nom}</span>
            {o.badge && <em>{o.badge}</em>}
          </div>
          <div class="price">
            {o.prix}{o.unite && <sup>{o.unite}</sup>}
          </div>
          <p class="d">{o.accroche}</p>
          <ul>{o.inclus.map((i) => <li>{i}</li>)}</ul>
          <a href={`/?offre=${o.id}#contact`} data-offre={o.id} class:list={['btn', o.feat ? 'btn-p' : 'btn-g']}>{o.cta}</a>
        </div>
      ))}
    </div>
    <OfferTerms />
  </div>
</section>
