---
/**
 * Séquence du hero : dans le cadre d'écran, un site se construit en une
 * douzaine de secondes, pour montrer la promesse « en ligne en 7 jours ».
 *
 * Les quatre phases reprennent la méthode (`data/methode.ts`) :
 *   Cadrage · Jour 1           carte de brief, trois champs tapés
 *   Design · Jour 2 → 3        wireframe gris posé bloc par bloc, puis mis
 *                              aux couleurs du client
 *   Développement · Jour 3 → 6 extraits réels de son code pendant que la
 *                              capture du site remplace la maquette
 *   Mise en ligne · Jour 7     URL, badge « En ligne », puis la fin propre au
 *                              projet (notification ou leads qui arrivent)
 *
 * Deux projets en boucle (`data/sequence.ts`), un onglet chacun. Tout est
 * piloté par la Web Animations API : chaque étape d'un élément devient une
 * animation calée sur la durée totale du projet (délai avant, délai après),
 * et toutes démarrent ensemble. Mettre en pause, reprendre ou sauter à l'état
 * final revient donc à agir sur la même horloge pour toutes.
 *
 * A remplacé la vitrine vidéo KlientMap le 29/09/2026 (source archivée dans
 * `medias-en-reserve/`).
 */
import { projets } from '../data/sequence';
import { etapes } from '../data/methode';
import Icon from './Icon.astro';
import Delai from './Delai.astro';

const premier = projets[0];
const pc = (v: number) => `${v}%`;
const boite = (b: { x: number; y: number; w: number; h: number }) =>
  `left:${pc(b.x)};top:${pc(b.y)};width:${pc(b.w)};height:${pc(b.h)}`;
---

<div class="mockwrap rv sq" data-sq>
  <div class="proj" aria-hidden="true"><i></i></div>

  <div class="mockframe">
    <div class="mock glass">
      {/* barre des cartes Réalisations (`.barre`) ; ses règles visent tout
          `span` et tout `i` descendants, d'où les `em`/`b` à l'intérieur */}
      <div class="barre">
        <i></i><i></i><i></i>
        <div class="sq-url">
          <em class="sq-pre" data-u-pre>préproduction</em>
          <em class="sq-prod" data-u-prod><b data-u-hote>{premier.url}</b><b data-u-chemin></b></em>
        </div>
        {/* phase en cours : dans la barre sur ordinateur, dans l'écran sur mobile */}
        <p class="sq-phases" aria-hidden="true">
          {etapes.map((e) => (
            <em class="sq-phase" data-phase><b>{e.num}</b>{e.titre}<u><Delai texte={e.delai} /></u></em>
          ))}
        </p>
        <b class="sq-live" data-live><em><u data-live-onde></u><s data-live-on></s></em>En ligne</b>
      </div>
      <div class="sq-jours" aria-hidden="true"><i data-avance></i></div>

      <div class="sq-ecran" id="sq-ecran" role="tabpanel" aria-labelledby={`sq-onglet-${premier.id}`} data-ecran>
        {projets.map((p, i) => (
          <div
            class="sq-projet"
            data-projet={p.id}
            data-nom={p.nom}
            data-url={p.url}
            data-chemin={p.chemin ?? ''}
            data-fin={p.fin.type}
            hidden={i !== 0}
            style={p.couleurs}
          >
            <div class="sq-page" data-page>
              {(['gris', 'couleur'] as const).map((couche) => (
                <div class={`sq-wire sq-${couche}`} data-wire={couche} aria-hidden="true">
                  {p.blocs.map((b) => <i class={`b-${b.role}`} style={boite(b)} />)}
                </div>
              ))}
              <i class="sq-onde" data-onde aria-hidden="true" />
              <i class="sq-scan" data-scan aria-hidden="true" />
              <img
                class="sq-shot"
                data-shot
                src={p.capture.src}
                srcset={`${p.capture.src1x} 1440w, ${p.capture.src} 2880w`}
                sizes="(max-width: 760px) 200vw, min(1166px, 100vw)"
                width="2880"
                height="1440"
                alt={p.capture.alt}
                loading="lazy"
                decoding="async"
              />
              {p.fin.type === 'leads' && (
                <div class="sq-app" data-app>
                  <img
                    src={p.fin.src}
                    srcset={`${p.fin.src1x} ${p.fin.largeur / 2}w, ${p.fin.src} ${p.fin.largeur}w`}
                    sizes="(max-width: 760px) 200vw, min(1166px, 100vw)"
                    width={p.fin.largeur}
                    height={p.fin.hauteur}
                    alt={p.fin.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  {p.fin.colonnes.map((c) => <i class="sq-vide" style={`${boite(c)};background:${c.fond}`} />)}
                  {p.fin.cartes.map((c) => (
                    <span
                      class="sq-carte"
                      data-carte={c.rang}
                      style={`clip-path:inset(${c.y}% ${100 - c.x - c.w}% ${100 - c.y - c.h}% ${c.x}% round 0.6%)`}
                      aria-hidden="true"
                    >
                      <img src={p.fin.src} srcset={`${p.fin.src1x} ${p.fin.largeur / 2}w, ${p.fin.src} ${p.fin.largeur}w`}
                        sizes="(max-width: 760px) 200vw, min(1166px, 100vw)" width={p.fin.largeur} height={p.fin.hauteur}
                        alt="" loading="lazy" decoding="async" />
                    </span>
                  ))}
                </div>
              )}
              <i class="sq-reflet" data-reflet aria-hidden="true" />
            </div>

            <div class="sq-brief glass" data-brief>
              <p class="sq-tete"><span>Brief</span><em>Appel de 15 min</em></p>
              <dl>
                {p.brief.map((c) => (
                  <div class={c.mobile ? undefined : 'sq-opt'}>
                    <dt>{c.label}</dt>
                    <dd><span data-frappe style={`--n:${c.valeur.length}`}>{c.valeur}</span></dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="sq-code sq-sombre" data-code aria-hidden="true">
              <p class="sq-tete"><span>{p.dossier}</span></p>
              <div class="sq-code-vue">
                <ol data-lignes>
                  {p.code.map((l) => (
                    <li class:list={[{ 'sq-fichier': !l.n, 'sq-opt': !l.mobile }]} data-ligne>
                      <span>{l.n ?? ''}</span><code>{l.code}</code>
                    </li>
                  ))}
                </ol>
              </div>
            </div>

            {p.fin.type === 'notification' && (
              <div class="sq-notif sq-sombre" data-notif>
                <span class="sq-icone" data-icone aria-hidden="true">
                  <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></svg>
                </span>
                <span class="sq-notif-txt">
                  <b>{p.fin.titre}</b>
                  <span>{p.fin.detail}</span>
                </span>
                <em>À l'instant</em>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="demo-actions sq-actions">
    <div class="sq-onglets" role="tablist" aria-label="Projets présentés">
      {/* fond de l'onglet actif, qui glisse de l'un à l'autre ; sa jauge suit le projet en cours */}
      <span class="sq-indic" data-indic aria-hidden="true"><i data-indic-jauge></i></span>
      {projets.map((p, i) => (
        <button
          type="button"
          role="tab"
          id={`sq-onglet-${p.id}`}
          aria-controls="sq-ecran"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-onglet={i}
        >
          <b>{p.nom}</b><em>Offre {p.offre}</em>
        </button>
      ))}
    </div>
    <button type="button" class="sq-pause" data-pause aria-pressed="false" aria-label="Mettre l'animation en pause">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="sq-ico-pause" d="M9 6v12M15 6v12" /><path class="sq-ico-lire" d="M8 5.5v13l11-6.5z" /></svg>
    </button>
    <a class="text-link" data-lien href={`/realisations/${premier.id}/`}>Découvrir le projet <span data-lien-nom>{premier.nom}</span> <Icon name="arrow" class="i" /></a>
  </div>

  <!-- sans JavaScript : l'état final du premier projet, immobile -->
  <noscript><style>
    .sq-shot,.sq-prod,.sq-prod b,.sq-live,.sq-live s,.sq-notif,.sq-phase:last-child{opacity:1!important;clip-path:none!important;transform:none!important}
    .sq-pause{display:none!important}
    .sq-indic{display:none}
    .sq-onglets [aria-selected='true']{background:color-mix(in srgb,var(--fg) 14%,transparent);border-color:var(--edge)}
  </style></noscript>
</div>

<script>
  type Etape = [number, Keyframe, string?];

  const racine = document.querySelector<HTMLElement>('[data-sq]');

  if (racine) {
    const $ = <T extends Element = HTMLElement>(sel: string, dans: ParentNode = racine) => dans.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string, dans: ParentNode = racine) =>
      Array.from(dans.querySelectorAll<T>(sel));

    const calme = matchMedia('(prefers-reduced-motion: reduce)');
    const etroit = matchMedia('(max-width: 760px)');
    const projets = $$('[data-projet]');
    const onglets = $$<HTMLButtonElement>('[data-onglet]');
    const bouton = $<HTMLButtonElement>('[data-pause]')!;
    const lien = $<HTMLAnchorElement>('[data-lien]')!;
    const lienNom = $('[data-lien-nom]')!;
    const ecran = $('[data-ecran]')!;
    const hote = $('[data-u-hote]')!;
    const chemin = $('[data-u-chemin]')!;
    const liste = $('[role="tablist"]')!;
    const indic = $('[data-indic]')!;
    const jauge = $('[data-indic-jauge]')!;

    // Repères de la séquence, en millisecondes. Mêmes pour les deux projets
    // jusqu'à la mise en ligne ; seule la fin (notification ou leads) diffère.
    const T = { design: 2400, dev: 5200, ligne: 8600, fin: 9900 } as const;
    const FIN = { notification: 2500, leads: 3500 } as const;
    const SORTIE = 600;
    // Courbes : entrées longues qui se posent, sorties courtes qui accélèrent,
    // un seul ressort, discret, pour ce qui « arrive » (boutons, notification).
    const SOUPLE = 'cubic-bezier(.16,1,.3,1)';
    const POSE = 'cubic-bezier(.2,.75,.15,1)';
    const FILE = 'cubic-bezier(.5,0,.9,.3)';
    const RESSORT = 'cubic-bezier(.3,1.25,.5,1)';
    const BALAYE = 'cubic-bezier(.65,0,.35,1)';

    /**
     * Lignes réellement affichées : le mobile masque les `.sq-opt` (même
     * point de rupture que le CSS). Pas de getComputedStyle ici : la page
     * contient des conteneurs de taille, et tout calcul de style y force la
     * mise en page complète (mesuré : 170 ms de tâche bloquante au chargement
     * sur mobile).
     */
    const affiche = (els: HTMLElement[]) => (etroit.matches ? els.filter((el) => !el.classList.contains('sq-opt')) : els);

    let actif = 0;
    let anims: Animation[] = [];
    let arret = 0; // temps de l'état final (juste avant le fondu de sortie)
    let visible = false;
    let pauseVoulue = false;
    // au chargement, le cadre fait d'abord son entrée (global.css) : la
    // séquence attend qu'il soit posé pour démarrer
    let pret = calme.matches;

    function construire(i: number) {
      anims.forEach((a) => a.cancel());
      anims = [];
      const p = projets[i];
      const fin = p.dataset.fin as keyof typeof FIN;
      const D = T.fin + FIN[fin] + SORTIE;
      arret = D - SORTIE;

      /**
       * Une piste = les étapes d'un élément sur la durée D. Chaque passage
       * d'une étape à la suivante devient sa propre animation, qui ne tourne
       * que pendant ce passage (délai avant, `endDelay` après : toutes ont la
       * même durée totale D, donc la même horloge). Entre deux passages, la
       * valeur est tenue par le remplissage et le navigateur n'a plus rien à
       * recalculer : une seule animation sur tout D forçait le recalcul de
       * style de chaque élément à chaque image, même immobile (mesuré : plus
       * de 400 ms de style pendant un défilement sur mobile).
       * La première tient aussi l'état de départ (`both`) ; les suivantes,
       * créées au-dessus, ne s'appliquent qu'une fois commencées (`forwards`).
       */
      const piste = (el: Element | null, etapes: Etape[], easing = SOUPLE) => {
        if (!el) return;
        const meme = (a: Keyframe, b: Keyframe) => JSON.stringify(a) === JSON.stringify(b);
        let premier = true;
        const segment = (t0: number, t1: number, k0: Keyframe, k1: Keyframe, e: string) => {
          const a = el.animate([{ ...k0, easing: e }, k1], {
            delay: t0,
            duration: Math.max(1, t1 - t0),
            endDelay: D - Math.max(t1, t0 + 1),
            fill: premier ? 'both' : 'forwards',
          });
          premier = false;
          a.pause();
          anims.push(a);
        };
        for (let i = 0; i < etapes.length - 1; i++) {
          const [t0, k0, e] = etapes[i];
          const [t1, k1] = etapes[i + 1];
          if (!meme(k0, k1)) segment(Math.min(t0, D), Math.min(t1, D), k0, k1, e ?? easing);
        }
        // piste immobile : son état tient seul
        if (premier) segment(0, D, etapes[0][1], etapes[0][1], 'linear');
      };
      const cache = { opacity: 0 };
      const vu = { opacity: 1 };

      // Horloge : un effet sans cible, dont la fin enchaîne sur l'autre projet.
      const horloge = new Animation(new KeyframeEffect(null, null, { duration: D }));
      horloge.onfinish = () => lancer((actif + 1) % projets.length);
      anims.push(horloge);

      // ---- repères communs : phase en cours, jours écoulés, barre d'adresse ----
      const debuts = [0, T.design, T.dev, T.ligne, arret];
      $$('[data-phase]').forEach((el, k) => {
        const a = debuts[k], b = debuts[k + 1];
        const bas = { opacity: 0, transform: 'translateY(55%) scale(.94)' };
        const haut = { opacity: 0, transform: 'translateY(-55%) scale(.94)' };
        const ici = { opacity: 1, transform: 'none' };
        piste(el, k === 3
          ? [[a, bas], [a + 500, ici], [arret, ici, FILE], [D, haut]]
          : [[a, bas], [a + 500, ici], [b - 60, ici, FILE], [b + 160, haut]]);
      });
      // la jauge avance jour par jour : chaque phase la pousse jusqu'à son
      // dernier jour, et elle se remplit pile à la mise en ligne
      const jour = (n: number) => ({ transform: `scaleX(${n / 7})`, opacity: 1 });
      piste($('[data-avance]'), [
        [0, jour(0)],
        [300, jour(0)], [T.design - 200, jour(1)],
        [T.design + 200, jour(1)], [T.dev - 200, jour(3)],
        [T.dev + 200, jour(3)], [T.ligne - 100, jour(6)],
        [T.ligne + 100, jour(6)], [T.ligne + 700, jour(7)],
        [arret, jour(7), FILE], [D, { transform: 'scaleX(1)', opacity: 0 }],
      ], POSE);
      piste($('[data-u-pre]'), [[T.dev, cache], [T.dev + 300, vu], [T.ligne, vu, FILE], [T.ligne + 150, cache]]);
      const typo = (el: HTMLElement, t: number, duree: number) => {
        const n = Math.max(1, el.textContent!.length);
        piste(el, [
          [t, { clipPath: 'inset(0 100% 0 0)' }, `steps(${n}, end)`],
          [t + duree, { clipPath: 'inset(0 0% 0 0)' }],
        ]);
      };
      piste($('[data-u-prod]'), [[T.ligne + 100, vu], [arret, vu], [D, cache]]);
      typo(hote, T.ligne + 100, 600);
      typo(chemin, T.fin, 300);

      // ---- mise en ligne : voyant qui s'allume, onde, reflet sur l'écran ----
      const eteint = { opacity: 0.4, borderColor: 'rgba(255,255,255,.32)', boxShadow: '0 0 0 0 rgba(167,139,250,0)' };
      const allume = { opacity: 1, borderColor: 'rgba(196,181,253,.7)', boxShadow: '0 0 22px -4px rgba(167,139,250,.75)' };
      piste($('[data-live]'), [[T.ligne + 650, eteint], [T.ligne + 1000, allume], [arret, allume], [D, eteint]]);
      piste($('[data-live-on]'), [
        [T.ligne + 650, { opacity: 0, transform: 'scale(.3)' }, RESSORT],
        [T.ligne + 1100, { opacity: 1, transform: 'none' }],
        [arret, { opacity: 1, transform: 'none' }],
        [D, { opacity: 0, transform: 'none' }],
      ]);
      piste($('[data-live-onde]'), [
        [T.ligne + 700, { opacity: 0.9, transform: 'scale(1)' }],
        [T.ligne + 1700, { opacity: 0, transform: 'scale(4.2)' }],
      ], 'cubic-bezier(.2,.6,.3,1)');
      piste($('[data-reflet]', p), [
        [T.ligne + 750, { transform: 'translateX(-100%)' }],
        [T.ligne + 1650, { transform: 'translateX(100%)' }],
      ], 'cubic-bezier(.45,0,.2,1)');

      // ---- 1. Cadrage : la carte de brief, ses champs posés puis tapés ----
      const brief = $('[data-brief]', p);
      piste(brief, [
        [100, { opacity: 0, transform: 'translate(-50%, -43%) scale(.92)' }],
        [800, { opacity: 1, transform: 'translate(-50%, -50%) scale(1)' }],
        [T.design - 50, { opacity: 1, transform: 'translate(-50%, -50%) scale(1)' }, FILE],
        [T.design + 250, { opacity: 0, transform: 'translate(-50%, -50%) scale(1.07)' }],
      ]);
      const repos = { borderColor: 'rgba(255,255,255,.18)', backgroundColor: 'rgba(0,0,0,.22)' };
      const saisie = { borderColor: 'rgba(196,181,253,.65)', backgroundColor: 'rgba(99,102,241,.16)' };
      affiche($$('dl > div', brief)).forEach((champ, j) => {
        const t = 700 + j * 550;
        piste(champ, [
          [220 + j * 70, { opacity: 0, transform: 'translateY(8px)', ...repos }],
          [600 + j * 70, { opacity: 1, transform: 'none', ...repos }],
          [t - 60, { opacity: 1, transform: 'none', ...repos }],
          [t + 80, { opacity: 1, transform: 'none', ...saisie }],
          [t + 480, { opacity: 1, transform: 'none', ...saisie }],
          [t + 800, { opacity: 1, transform: 'none', ...repos }],
        ], 'ease-out');
        typo($('[data-frappe]', champ)!, t, 450);
      });

      // ---- 2. Design : wireframe tracé en ordre de lecture, puis onde de couleur ----
      // chaque bloc se trace selon sa nature : les lignes de texte s'étirent
      // depuis la gauche, les titres montent, les boutons éclosent
      const trace: Record<string, Keyframe> = {
        texte: { opacity: 0, transform: 'scaleX(0)' },
        lien: { opacity: 0, transform: 'scaleX(0)' },
        titre: { opacity: 0, transform: 'scaleY(.15)' },
        bouton: { opacity: 0, transform: 'scale(.5)' },
        pilule: { opacity: 0, transform: 'scale(.5)' },
        rond: { opacity: 0, transform: 'scale(.4)' },
        surface: { opacity: 0, transform: 'scale(.97)' },
      };
      $$('[data-wire="gris"] > i', p).forEach((b) => {
        const role = /b-(\w+)/.exec(b.className)?.[1] ?? '';
        const t = T.design + 150 + parseFloat(b.style.top) * 6 + parseFloat(b.style.left) * 2.5;
        const ressort = role === 'bouton' || role === 'pilule' || role === 'rond';
        piste(b, [[t, trace[role] ?? cache, ressort ? RESSORT : POSE], [t + (ressort ? 550 : 480), { opacity: 1, transform: 'none' }]]);
      });
      piste($('[data-wire="gris"]', p), [[T.dev + 2400, vu], [T.dev + 2500, cache]]);
      // la couleur du client se répand en cercle depuis le titre, bordée d'une onde lumineuse
      const COULEUR = [T.design + 1650, T.design + 2600] as const;
      piste($('[data-wire="couleur"]', p), [
        [COULEUR[0], { clipPath: 'circle(0% at 50% 45%)' }, BALAYE],
        [COULEUR[1], { clipPath: 'circle(75% at 50% 45%)' }],
      ]);
      const onde = $('[data-onde]', p);
      // sa taille (pas un scale : le liseré rétrécirait avec elle et disparaîtrait)
      piste(onde, [[COULEUR[0], { width: '0%' }, BALAYE], [COULEUR[1], { width: '118.6%' }]]);
      piste(onde, [[COULEUR[0], cache], [COULEUR[0] + 120, vu], [COULEUR[1] - 350, vu, 'ease-in'], [COULEUR[1], cache]]);

      // ---- 3. Développement : la capture se révèle sous un front de lumière, le code défile ----
      const REVELE = [T.dev + 400, T.dev + 2400] as const;
      piste($('[data-shot]', p), [
        [REVELE[0], { clipPath: 'inset(0 0 100% 0)' }, BALAYE],
        [REVELE[1], { clipPath: 'inset(0 0 0% 0)' }],
      ]);
      // le bas du front suit exactement le bord de la découpe (même courbe)
      const front = (k: number) => ({ transform: `translateY(calc(${k * 100}cqh - 100%))` });
      piste($('[data-scan]', p), [[REVELE[0], front(0), BALAYE], [REVELE[1], front(1)]]);
      piste($('[data-scan]', p), [[REVELE[0], cache], [REVELE[0] + 150, vu], [REVELE[1] - 250, vu, 'ease-in'], [REVELE[1] + 100, cache]]);

      const code = $('[data-code]', p)!;
      piste(code, [
        [T.dev + 100, { opacity: 0, transform: 'translateY(14%) scale(.97)' }],
        [T.dev + 700, { opacity: 1, transform: 'none' }],
        [T.ligne - 280, { opacity: 1, transform: 'none' }, FILE],
        [T.ligne, { opacity: 0, transform: 'translateY(6%) scale(.98)' }],
      ]);
      const lignes = affiche($$('[data-ligne]', code));
      // lignes visibles du panneau : `--lignes` du CSS (4, 3 sur mobile). Pas
      // lu par getComputedStyle, pour la même raison que dans `affiche`
      const vues = etroit.matches ? 3 : 4;
      const pas = 2700 / lignes.length;
      // le panneau montre `vues` lignes : chaque ligne suivante le fait monter d'un cran
      const cran = (k: number) => ({ transform: `translateY(${-k * 1.7}em)` });
      const defile: Etape[] = [[0, cran(0)]];
      lignes.forEach((l, j) => {
        const t = T.dev + 400 + j * pas;
        piste(l, [
          [t, { opacity: 0, transform: 'translateY(.45em)', filter: 'blur(4px)' }, POSE],
          [t + 380, { opacity: 1, transform: 'none', filter: 'blur(0)' }],
        ]);
        if (j >= vues) defile.push([t, cran(j - vues), POSE], [t + Math.min(380, pas), cran(j - vues + 1)]);
      });
      if (defile.length > 1) piste($('[data-lignes]', code), defile);

      // ---- 4. Mise en ligne : la fin propre au projet ----
      if (fin === 'notification') {
        piste($('[data-notif]', p), [
          [T.fin, { opacity: 0, transform: 'translateY(35%) scale(.95)' }, RESSORT],
          [T.fin + 700, { opacity: 1, transform: 'none' }],
        ]);
        piste($('[data-icone]', p), [
          [T.fin + 180, { opacity: 0, transform: 'scale(.4) rotate(-12deg)' }, RESSORT],
          [T.fin + 750, { opacity: 1, transform: 'none' }],
        ]);
      } else {
        // l'appli remplace la landing, puis les leads arrivent rangée par rangée
        piste($('[data-app]', p), [[T.fin, cache], [T.fin + 500, vu]]);
        // sur mobile le cadre ne montre que le début de la page : on se cale à gauche
        piste($('[data-page]', p), [
          [T.fin, { left: 'calc((100cqw - 200cqh) / 2)' }],
          [T.fin + 700, { left: '0px' }],
        ]);
        $$('[data-carte]', p).forEach((c) => {
          const t = T.fin + 600 + Number(c.dataset.carte) * 300;
          piste(c, [
            [t, { opacity: 0, transform: 'translateY(3cqh) scale(.96)' }, RESSORT],
            [t + 550, { opacity: 1, transform: 'none' }],
          ]);
        });
      }

      // jauge de l'onglet : le temps restant avant le projet suivant
      piste(jauge, [[0, { transform: 'scaleX(0)' }], [D, { transform: 'scaleX(1)' }]], 'linear');

      piste(p, [[arret, { opacity: 1, transform: 'none' }, FILE], [D, { opacity: 0, transform: 'scale(.985)' }]]);
    }

    /**
     * Captures en `loading="lazy"`, mais Chromium (Chrome, Brave) ne charge
     * jamais une image entièrement masquée par `clip-path` : c'est l'état de
     * départ de la capture, qui restait donc vide. Dès que le bloc est à
     * l'écran, celles du projet en cours et du suivant passent en immédiat.
     */
    const charger = (i: number) => {
      for (const k of [i, (i + 1) % projets.length])
        $$<HTMLImageElement>('img', projets[k]).forEach((img) => (img.loading = 'eager'));
    };

    const jouer = () => anims.forEach((a) => a.play());
    const suspendre = () => anims.forEach((a) => a.pause());
    const maj = () => {
      if (calme.matches) return;
      if (visible && pret && !pauseVoulue && !document.hidden) jouer();
      else suspendre();
    };

    /**
     * Cale le fond glissant sur l'onglet actif (sa transition CSS fait le
     * trajet). La toute première pose attend le ResizeObserver, qui passe
     * après la mise en page : lue plus tôt, la position forçait une mise en
     * page complète de la page pendant le chargement du script.
     */
    let place = false;
    const placer = () => {
      const o = onglets[actif];
      indic.style.setProperty('--x', `${o.offsetLeft}px`);
      indic.style.setProperty('--w', `${o.offsetWidth}px`);
      // première position posée sans trajet ; le fond glisse ensuite d'onglet en onglet
      if (!place) requestAnimationFrame(() => (liste.dataset.pret = ''));
      place = true;
    };

    function lancer(i: number, t = 0) {
      actif = i;
      projets.forEach((p, k) => (p.hidden = k !== i));
      const p = projets[i];
      hote.textContent = p.dataset.url || '';
      chemin.textContent = p.dataset.chemin || '';
      onglets.forEach((o, k) => {
        o.setAttribute('aria-selected', String(k === i));
        o.tabIndex = k === i ? 0 : -1;
      });
      ecran.setAttribute('aria-labelledby', onglets[i].id);
      if (place) placer();
      lien.href = `/realisations/${p.dataset.projet}/`;
      lienNom.textContent = p.dataset.nom ?? '';

      construire(i);
      if (visible || calme.matches) charger(i);
      if (calme.matches) {
        // animations réduites : l'état final, immobile
        anims.forEach((a) => { a.currentTime = arret; a.pause(); });
        return;
      }
      anims.forEach((a) => (a.currentTime = t));
      maj();
    }

    const majBouton = () => {
      bouton.setAttribute('aria-pressed', String(pauseVoulue));
      bouton.setAttribute('aria-label', pauseVoulue ? "Reprendre l'animation" : "Mettre l'animation en pause");
    };

    onglets.forEach((o, i) =>
      o.addEventListener('click', () => {
        pauseVoulue = false;
        pret = true;
        majBouton();
        lancer(i);
      }),
    );
    // flèches du clavier dans la liste d'onglets (motif ARIA « tabs »)
    liste.addEventListener('keydown', (e) => {
      const sens = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!sens) return;
      e.preventDefault();
      const i = (actif + sens + onglets.length) % onglets.length;
      onglets[i].focus();
      onglets[i].click();
    });

    bouton.addEventListener('click', () => {
      pauseVoulue = !pauseVoulue;
      majBouton();
      maj();
    });
    bouton.hidden = calme.matches;

    new IntersectionObserver(
      (entrees) => {
        visible = entrees.some((e) => e.isIntersecting);
        if (visible) charger(actif);
        maj();
      },
      { threshold: 0.25 },
    ).observe(ecran);
    document.addEventListener('visibilitychange', maj);
    calme.addEventListener('change', () => {
      bouton.hidden = calme.matches;
      lancer(actif);
    });
    // le mobile masque des champs et des lignes : on reconstruit au même instant
    etroit.addEventListener('change', () => lancer(actif, Number(anims[0]?.currentTime) || 0));

    // les largeurs d'onglets bougent au chargement des polices et au redimensionnement
    new ResizeObserver(placer).observe(liste);

    lancer(0);
    setTimeout(() => {
      pret = true;
      maj();
    }, 1000);
  }
</script>

<style>
  /* Variables propres au bloc. Le site n'a de variables que pour ses
