---
/**
 * Mur de réalisations du haut de page : rangées de captures qui défilent en
 * biais, en sens alternés. Vues bureau de tous les projets, avec quelques
 * vues téléphone glissées dedans pour qu'on reconnaisse des sites.
 * Décoratif (aria-hidden) : le lien « voir les projets » porte l'info.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { realisations } from '../data/realisations';
import { capture, existe } from '../lib/projets';

type Tuile = { id: string; tel: boolean };
const bureau = realisations.map((r) => r.id);
const tel = realisations.filter((r) => existe(r.id, 'mobile')).map((r) => r.id);

// Tirage pseudo-aléatoire à graine fixe : le mur est mélangé, mais identique
// d'un build à l'autre (pas de différence entre deux déploiements).
let graine = 20261001;
const hasard = () => ((graine = (graine * 1664525 + 1013904223) >>> 0) / 2 ** 32);
const melanger = <T,>(liste: T[]) => {
  const l = [...liste];
  for (let i = l.length - 1; i > 0; i--) {
    const j = Math.floor(hasard() * (i + 1));
    [l[i], l[j]] = [l[j], l[i]];
  }
  return l;
};

/**
 * Une rangée : tous les sites en vue bureau, dans un ordre mélangé, et trois
 * vues téléphone glissées dedans (des visuels différents, qui espacent les
 * répétitions). Chaque capture n'apparaît qu'une fois par tour de rangée ;
 * une vue téléphone n'est jamais voisine de la vue bureau du même site, et
 * on évite qu'une capture tombe au même endroit que dans la rangée du dessus.
 */
const rangee = (precedente: Tuile[] | null): Tuile[] => {
  let meilleure: Tuile[] = [];
  let conflitsMin = Infinity;
  for (let essai = 0; essai < 400 && conflitsMin > 0; essai++) {
    const suite: Tuile[] = melanger(bureau).map((id) => ({ id, tel: false }));
    const dispo = melanger(tel);
    for (const pos of [2, 6, 10].map((p, k) => p + k + Math.floor(hasard() * 2))) {
      const voisins = suite.slice(Math.max(0, pos - 2), pos + 2).map((t) => t.id);
      const i = dispo.findIndex((id) => !voisins.includes(id));
      if (i > -1) suite.splice(pos, 0, { id: dispo.splice(i, 1)[0], tel: true });
    }
    const conflits = precedente
      ? suite.filter((t, i) => [i - 1, i, i + 1].some((k) => precedente[k]?.id === t.id)).length
      : 0;
    if (conflits < conflitsMin) [meilleure, conflitsMin] = [suite, conflits];
  }
  return meilleure;
};
const lignes: Tuile[][] = [];
for (let i = 0; i < 6; i++) lignes.push(rangee(lignes[i - 1] ?? null));
// sens alternés, durées toutes différentes pour que les rangées ne se calent jamais
const durees = [132, 114, 150, 122, 140, 106];
const rangees = lignes.map((t, i) => ({ t, sens: i % 2 ? 'd' : '', d: durees[i] }));
---

<div class="mur" id="mur">
  <div class="mur-rot" aria-hidden="true">
    {rangees.map((r) => (
      <div class:list={['mrow', r.sens]} style={`--d: ${r.d}s`}>
        {[0, 1].map(() =>
          r.t.map((t) => (
            <div class:list={['tuile', { tel: t.tel }]}>
              {t.tel ? (
                <Image src={capture(t.id, 'mobile')} widths={[120, 240]} sizes="(max-width: 700px) 61px, 108px" format="webp" quality={70} alt="" loading="lazy" decoding="async" />
              ) : (
                <Image src={capture(t.id, 'thumb')} widths={[320, 640]} sizes="(max-width: 700px) 196px, 344px" format="webp" quality={70} alt="" loading="lazy" decoding="async" />
              )}
            </div>
          )),
        )}
      </div>
    ))}
  </div>
  <a class="mur-lien" href="/realisations/">Voir les projets<Icon name="arrow" class="i" /></a>
</div>

<script>
  // le mur ne tourne que lorsqu'il est à l'écran
  const mur = document.getElementById('mur');
  if (mur && 'IntersectionObserver' in window)
    new IntersectionObserver(([e]) => mur.classList.toggle('pause', !e.isIntersecting)).observe(mur);
</script>
