---
import Icon from './Icon.astro';
import { questionsAccueil as questions } from '../data/faq';
---

<section class="sec" id="faq">
  <div class="wrap fsplit">
    <div class="intro rv">
      <span class="lab">FAQ</span>
      <h2>Les questions qu'on nous pose avant de signer.</h2>
      <p>Une réponse manque ? Écrivez-nous, vous l'aurez sous 24&nbsp;h.</p>
      <a href="#contact" class="btn btn-g">Poser une question</a>
    </div>
    <div class="faq rv">
      {questions.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}<Icon name="plus" class="i" /></summary>
          <p>{item.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
