---
/**
 * Demande de devis. Formulaire court (nom, un moyen de vous joindre, métier,
 * formule) : chaque champ en moins, c'est une demande de plus. Le message
 * reste facultatif, on rappelle de toute façon pour cadrer.
 * Envoi par Netlify Forms (champs cachés form-name et bot-field).
 */
import Icon from './Icon.astro';
import { contact, presentation } from '../data/site';
import { realisations } from '../data/realisations';
import { secteurs } from '../data/secteurs';
import { offres } from '../data/offres';

interface Props {
  /** métier ou prestation de la page d'origine, transmis avec la demande */
  secteur?: string;
  /** projet de référence (page d'une réalisation) */
  projet?: string;
}
const { secteur = '', projet = '' } = Astro.props;
const metiers = [...secteurs.map((s) => s.nom), 'Autre activité'];
const formules = [...offres.map((o) => ({ id: o.id, nom: o.unite ? `${o.nom} · ${o.prix} € HT/mois ou ${o.achat} € HT` : o.nom })), { id: '', nom: 'Je ne sais pas' }];
---

<section class="sec" id="contact">
  <div class="wrap">
    <div class="cbox rv">
      <div class="cinfo">
        <span class="lab">Devis gratuit</span>
        <h2>Votre devis <span class="acc">sous 24&nbsp;h.</span></h2>
        <p>Deux lignes sur votre activité suffisent. On vous rappelle pour préciser le périmètre, le budget et la date de mise en ligne.</p>
        {(secteur || projet) && <p class="contexte">{projet ? `À propos du projet ${projet}` : `Votre demande : ${secteur}`}</p>}
        <p class="contexte" id="form-contexte" hidden></p>
        {presentation.lien && <p class="resa">Vous préférez choisir l'heure&nbsp;? <a href={presentation.lien} target="_blank" rel="noopener" data-presentation>Réservez votre appel de 15&nbsp;min</a></p>}
        <div class="coord">
          <a href={`tel:${contact.telLien}`}><Icon name="phone" class="i" />{contact.tel}<small>Ligne directe</small></a>
          <a href={`mailto:${contact.email}`}><Icon name="mail" class="i" />{contact.email}<small>Réponse sous 24&nbsp;h</small></a>
          <div><Icon name="pin" class="i" />Lyon, et à distance partout en France</div>
        </div>
      </div>

      <form class="cform" id="form-devis" name="contact" method="POST" action="/merci/"
        data-netlify="true" data-netlify-honeypot="bot-field" aria-label="Demande de devis"
        data-projets={JSON.stringify(realisations.map((p) => ({ id: p.id, nom: p.nom })))}>
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="secteur" value={secteur} />
        <input type="hidden" name="projet" value={projet} />
        <input type="hidden" name="provenance" value="" />
        <p hidden aria-hidden="true"><label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div class="f">
          <label for="n-nom">Nom *</label>
          <input id="n-nom" name="nom" type="text" placeholder="Votre nom" autocomplete="name" required maxlength="200" aria-describedby="fmsg" />
        </div>
        <div class="f">
          <label for="n-joindre">Téléphone ou e-mail *</label>
          <input id="n-joindre" name="coordonnees" type="text" placeholder="06 12 34 56 78" autocomplete="tel" required maxlength="200" aria-describedby="fmsg" />
        </div>
        <div class="f full">
          <label for="n-activite">Votre activité</label>
          <select id="n-activite" name="activite">
            <option value="">Choisir votre métier</option>
            {metiers.map((m) => <option selected={m === secteur}>{m}</option>)}
          </select>
        </div>
        <fieldset class="choix f full">
          <legend>Formule envisagée</legend>
          {formules.map((o) => (
            <label><input type="radio" name="offre" value={o.id} checked={o.id === ''} />{o.nom}</label>
          ))}
        </fieldset>
        <div class="f full">
          <label for="n-msg">Votre projet (facultatif)</label>
          <textarea id="n-msg" name="message" placeholder="Ce que vous voulez sur votre site, une échéance…" maxlength="10000"></textarea>
        </div>
        <div class="f full">
          <button type="submit" class="btn btn-p">Recevoir mon devis gratuit<Icon name="arrow" class="i" /></button>
          <div class="fmsg" id="fmsg" role="status" aria-live="polite" aria-atomic="true"></div>
        </div>
        <p class="note f full">Le devis ne vous engage à rien. Vos coordonnées servent uniquement à vous répondre. <a href="/confidentialite/">Vos données et vos droits</a></p>
      </form>
    </div>
  </div>
</section>

<script>
  import { suivre, provenance } from '../scripts/mesure';

  const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
  if (form) {
    const msg = form.querySelector<HTMLElement>('#fmsg')!;
    const radio = (valeur: string | null) =>
      valeur === null ? null : form.querySelector<HTMLInputElement>(`input[name="offre"][value="${CSS.escape(valeur)}"]`);
    const selectionner = (valeur: string | null) => {
      const r = radio(valeur);
      if (r) r.checked = true;
      return r;
    };

    // ?offre=visibilite et ?projet=kami : la demande arrive déjà renseignée
    const params = new URLSearchParams(location.search);
    selectionner(params.get('offre'));
    const references: { id: string; nom: string }[] = JSON.parse(form.dataset.projets ?? '[]');
    const reference = references.find((p) => p.id === params.get('projet'));
    if (reference) {
      (form.elements.namedItem('projet') as HTMLInputElement).value = reference.nom;
      const contexte = document.getElementById('form-contexte');
      if (contexte) {
        contexte.hidden = false;
        contexte.textContent = `Projet de référence : ${reference.nom}`;
      }
    }

    // boutons « Choisir Vitrine »… : formule cochée, sans recharger la page
    document.querySelectorAll<HTMLAnchorElement>('a[data-offre]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const r = selectionner(a.dataset.offre ?? null);
        const url = new URL(location.href);
        url.searchParams.set('offre', a.dataset.offre ?? '');
        url.hash = 'contact';
        history.replaceState(null, '', url);
        document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        r?.focus({ preventScroll: true });
      }),
    );

    const dire = (texte: string, ok: boolean) => {
      msg.dataset.state = ok ? 'ok' : 'error';
      msg.textContent = texte;
    };
    form.addEventListener('invalid', (e) => {
      (e.target as HTMLElement).setAttribute('aria-invalid', 'true');
      dire('Vérifiez les champs signalés avant d’envoyer votre demande.', false);
    }, true);
    form.addEventListener('input', (e) => {
      const champ = e.target as HTMLInputElement;
      champ.removeAttribute('aria-invalid');
      champ.setCustomValidity?.('');
      if (msg.dataset.state === 'error') msg.textContent = '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      for (const nom of ['nom', 'coordonnees']) {
        const champ = form.elements.namedItem(nom) as HTMLInputElement;
        if (!champ.value.trim()) {
          champ.setCustomValidity('Veuillez renseigner ce champ.');
          champ.reportValidity();
          champ.focus();
          return;
        }
      }
      if (import.meta.env.DEV || ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)) {
        dire('Aperçu local : aucune demande n’est envoyée. La réception se vérifie sur Netlify après déploiement.', false);
        return;
      }
      const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      bouton.disabled = true;
      form.setAttribute('aria-busy', 'true');
      dire('Envoi en cours…', true);
      try {
        (form.elements.namedItem('provenance') as HTMLInputElement).value = provenance();
        const corps = new URLSearchParams();
        new FormData(form).forEach((valeur, cle) => corps.append(cle, String(valeur)));
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: corps });
        if (!res.ok) throw new Error(String(res.status));
        suivre('devis', { page: location.pathname, offre: String(new FormData(form).get('offre') || 'aucune') });
        location.assign('/merci/');
      } catch {
        dire('L’envoi a échoué. Votre texte est conservé. Réessayez ou écrivez à contact@madaria.fr.', false);
        bouton.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  }
</script>
