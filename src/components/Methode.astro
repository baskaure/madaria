---
import SectionHead from './SectionHead.astro';
import Delai from './Delai.astro';
import { etapes } from '../data/methode';
---

<section class="sec" id="methode">
  <div class="wrap">
    <SectionHead label="Méthode">
      <Fragment slot="titre">Quatre étapes. <span class="acc">Sept jours.</span></Fragment>
      <p>Un point chaque jour et une préproduction ouverte en continu : vous voyez votre site avancer.</p>
    </SectionHead>
    <div class="etapes rv">
      {etapes.map((e) => (
        <div class="etape">
          <div class="jour"><Delai texte={e.delai} /></div>
          <h3>{e.titre}</h3>
          <p>{e.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
