---
import SectionHead from './SectionHead.astro';
import { projets } from '../data/travaux';
---

<section id="travaux">
  <div class="wrap">
    <SectionHead label="Travaux">
      <Fragment slot="titre">Des projets qui <span class="grad">rapportent</span>.</Fragment>
      Chaque projet est mesuré : trafic, conversions, temps gagné. Pas de captures flatteuses sans
      chiffres derrière.
    </SectionHead>

    <div class="works">
      {projets.map((p) => (
        <div class="glass work rv">
          <div class:list={['wtop', p.visuel]}></div>
          <div class="wbody">
            <div class="meta">{p.secteur}</div>
            <h3>{p.nom}</h3>
            <p>{p.text}</p>
            <div class="wkpi">
              {p.kpis.map((k) => (
                <div><b>{k.valeur}</b><span>{k.label}</span></div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
