---
/**
 * Vitrine du hero : un site réellement livré, présenté dans un cadre de verre.
 *
 * Remplace l'ancienne maquette de tableau de bord, dont les chiffres étaient
 * inventés : montrer une réalisation répond à la seule question que se pose un
 * visiteur d'agence — « est-ce qu'ils font de beaux sites ? ».
 */
import { vitrine as vedette } from '../data/realisations';
---

<div class="mockwrap rv">
  <!-- faisceau néon unique projeté au-dessus de l'écran -->
  <div class="proj" aria-hidden="true"><i></i></div>

  <div class="mockframe">
    <div class="mock glass">
      <div class="mtop">
        <i></i><i></i><i></i>
        <span class="url">{vedette.nom} — {vedette.secteur}</span>
      </div>

      <div class="mshot">
        {/* La page du site qui défile, en boucle et sans son. Lecture automatique
            quand le cadre est à l'écran, pause dès qu'il le quitte (voir script).
            Le poster tient la place avant le premier plan et reste seul si
            l'utilisateur préfère moins d'animations. */}
        <video
          id="vitrine-video"
          muted
          loop
          playsinline
          disablepictureinpicture
          disableremoteplayback
          preload="none"
          poster={vedette.poster}
          width={vedette.largeur}
          height={vedette.hauteur}
          aria-label={`Site internet réalisé pour ${vedette.nom} : la page défile`}
        >
          <source data-src={vedette.video.webm} type="video/webm" />
          <source data-src={vedette.video.mp4} type="video/mp4" />
          <img
            src={vedette.poster}
            alt={`Site internet réalisé pour ${vedette.nom}`}
            width={vedette.largeur}
            height={vedette.hauteur}
            loading="eager"
            decoding="async"
          />
        </video>
      </div>
    </div>
  </div>
  <div class="demo-actions">
    <a class="text-link" href="/realisations/klientmap/">Découvrir le projet KlientMap →</a>
  </div>
</div>

<script>
  // La vidéo ne tourne que lorsqu'on la regarde : pause quand le cadre sort de
  // l'écran, quand l'onglet passe en arrière-plan, ou si l'utilisateur préfère
  // moins d'animations (le poster reste alors affiché).
  const video = document.querySelector<HTMLVideoElement>('#vitrine-video');
  if (video) {
    const calme = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let chargee = false;
    const maj = () => {
      if (calme.matches || !visible || document.hidden) video.pause();
      else {
        if (!chargee) {
          video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach(source => {
            source.src = source.dataset.src!;
          });
          chargee = true;
          video.load();
        }
        video.play().catch(() => {});
      }
    };
    new IntersectionObserver(
      (entrees) => {
        visible = entrees.some((e) => e.isIntersecting);
        maj();
      },
      { threshold: 0.2 },
    ).observe(video);
    document.addEventListener('visibilitychange', maj);
    calme.addEventListener('change', maj);
  }
</script>
