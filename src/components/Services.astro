---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { services } from '../data/services';
---

<section id="services">
  <div class="wrap">
    <SectionHead label="Services">
      <Fragment slot="titre">
        Votre site internet,<br />
        de la première ligne au <span class="grad">dernier client</span>.
      </Fragment>
      Nous ne vendons pas des pages. Depuis Lyon, nous construisons des sites internet et des outils
      qui travaillent pour vous : rapides, mesurables, connectés à votre activité.
    </SectionHead>

    <div class="bento">
      {services.map((s) => (
        <div class:list={['glass', 'bcard', 'rv', { wide: s.wide }]}>
          <div class="spark"></div>
          <div class="ico"><Icon name={s.icon} /></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <div class="tags">{s.tags.map((t) => <b>{t}</b>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Le curseur allume l'arête de la carte et déplace la lueur intérieure.
  document.querySelectorAll<HTMLElement>('.bcard').forEach((card) => {
    const spark = card.querySelector<HTMLElement>('.spark');

    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      card.style.setProperty('--mx', `${x}px`);
      card.style.setProperty('--my', `${y}px`);
      if (spark) {
        spark.style.left = `${x - 120}px`;
        spark.style.right = 'auto';
        spark.style.width = '240px';
      }
    });
  });
</script>
