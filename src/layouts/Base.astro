---
import '../styles/global.css';
import { offresStructurees, prixEntree } from '../data/offres';
import { site, contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  preloadImage?: string;
}

const {
  // Title pensé pour la requête « création de site internet » : mot-clé en tête,
  // différenciateur (7 jours), zone (Lyon ET France : « à Lyon » seul laissait
  // croire à une activité purement locale), marque en fin. 61 caractères.
  // La marque est OBLIGATOIRE dans le title : sans elle le site a décroché
  // sur la requête « madaria » (sept. 2026). Ne plus la retirer.
  title = 'Création de site internet en 7 jours — Lyon & France | Madaria',
  description = `Agence web à Lyon et partout en France : site vitrine dès ${prixEntree}, création et maquette incluses, devis sous 24 h. En ligne en 7 jours.`,
  noindex = false,
  preloadImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);


const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://madaria.fr/#organisation',
      name: site.name,
      url: 'https://madaria.fr/',
      logo: 'https://madaria.fr/assets/07_logo_fond_sombre.svg',
      image: ogImage.href,
      description:
        "Agence digitale à Lyon : création de sites internet sur-mesure livrés en 7 jours, automatisations et outils métier, partout en France.",
      email: contact.email,
      telephone: '+33 6 99 68 19 57',
      priceRange: '€€',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '269 avenue Jean Jaurès',
        postalCode: '69007',
        addressLocality: 'Lyon',
        addressRegion: 'Auvergne-Rhône-Alpes',
        addressCountry: 'FR',
      },
      // Pas de `geo` : l'adresse est un domicile, exigée dans les mentions
      // légales mais pas à situer au mètre près. `areaServed` suffit pour une
      // activité 100 % à distance.
      areaServed: [
        { '@type': 'City', name: 'Lyon' },
        { '@type': 'Country', name: 'France' },
      ],
      sameAs: [
        'https://www.instagram.com/madaria_agency/',
        // Fiche Google Business, par son identifiant Knowledge Graph : stable,
        // contrairement au lien de partage qui redirige avec du tracking.
        'https://www.google.com/search?kgmid=/g/11zf9zzc34',
      ],
      founder: { '@id': 'https://madaria.fr/#fondateur' },
      slogan: 'Votre site internet en ligne en 7 jours.',
      currenciesAccepted: 'EUR',
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
      },
      knowsAbout: [
        'Création de site internet',
        'Site vitrine',
        'E-commerce',
        'Automatisation',
        'SEO',
        'Développement web',
      ],
      makesOffer: offresStructurees,
    },
    {
      '@type': 'Person',
      '@id': 'https://madaria.fr/#fondateur',
      name: 'Aurélien Branco',
      jobTitle: 'Fondateur et développeur',
      worksFor: { '@id': 'https://madaria.fr/#organisation' },
      knowsAbout: [
        'Développement web',
        'Astro',
        'Next.js',
        'Référencement naturel',
        'Automatisation des processus',
      ],
      sameAs: ['https://www.instagram.com/madaria_agency/'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://madaria.fr/#site',
      url: 'https://madaria.fr/',
      name: site.name,
      inLanguage: 'fr-FR',
      publisher: { '@id': 'https://madaria.fr/#organisation' },
    },
    {
      '@type': 'WebPage',
      '@id': canonical.href,
      url: canonical.href,
      name: title,
      description,
      inLanguage: 'fr-FR',

      isPartOf: { '@id': 'https://madaria.fr/#site' },
      about: { '@id': 'https://madaria.fr/#organisation' },
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <!-- Google cherche /favicon.ico en priorité ; le SVG sert aux navigateurs
         modernes, les PNG couvrent le reste. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Madaria — création de site internet livré en 7 jours" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Polices auto-hébergées (déclarées dans global.css). On précharge les
         deux sous-ensembles latins, utilisés par tout le texte visible au
         chargement ; latin-ext n'arrive que si un caractère l'exige. -->
    <link rel="preload" href="/fonts/sora-5.3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-5.3-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Sans JavaScript, les blocs `.rv` resteraient à opacité nulle : la page
         serait vide sous la ligne de flottaison. -->
    <noscript><style>.rv{opacity:1!important;transform:none!important}</style></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body id="top">
    <div id="nav-sentinel" aria-hidden="true"></div>
    <slot />

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
