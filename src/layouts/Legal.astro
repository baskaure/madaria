---
import Base from './Base.astro';
import Ariane from '../components/Ariane.astro';

interface Props {
  title: string;
  description: string;
  /** Titre affiché en haut de page */
  h1: string;
  majDate: string;
}

const { title, description, h1, majDate } = Astro.props;
---

<Base title={title} description={description} barre="/#contact">
  <section class="ph">
    <div class="wrap">
      <Ariane etapes={[{ label: h1 }]} />
      <h1>{h1}</h1>
      <p class="maj">Dernière mise à jour : {majDate}</p>
    </div>
  </section>
  <section class="sec court">
    <div class="wrap">
      <div class="prose"><slot /></div>
    </div>
  </section>
</Base>
