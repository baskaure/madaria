---
/**
 * Métiers : une ligne de liens compacte. Chaque lien mène à la page métier,
 * c'est le maillage interne le plus utile de l'accueil : ne pas le retirer.
 */
import { secteurs } from '../data/secteurs';
---

<section class="metiers-ligne" id="secteurs">
  <div class="wrap rv">
    <h2>Un site pensé pour votre métier</h2>
    <nav aria-label="Sites par métier">
      {secteurs.map((s) => <a href={`/site-internet/${s.slug}/`}>{s.nom}</a>)}
      <a class="autre" href="#contact">Autre métier&nbsp;? Parlons-en</a>
    </nav>
  </div>
</section>
